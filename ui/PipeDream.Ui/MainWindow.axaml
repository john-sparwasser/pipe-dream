<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PipeDream.Ui"
        x:Class="PipeDream.Ui.MainWindow"
        Title="pipe-dream" Width="1500" Height="900"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <!-- Header mode toggle: the canvas IS the editor, so switching editors is a canvas mode
         rather than another panel competing for the drawer. -->
    <Style Selector="ToggleButton.mode">
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="MinWidth" Value="82"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ToggleButton.mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Width" Value="4"/>
    </Style>
    <!-- Catalog rows are their own height (a 48px thumbnail), so the default item padding
         would waste half the drawer. -->
    <Style Selector="ListBox.catalog ListBoxItem">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" Click="OnNewProject" InputGesture="Ctrl+N"/>
        <MenuItem Header="_Open Project…" Click="OnOpenProject" InputGesture="Ctrl+O"/>
        <MenuItem Header="Open _ROM…" Click="OnOpenRom"/>
        <Separator/>
        <MenuItem Header="_Save" Click="OnSave" InputGesture="Ctrl+S"/>
        <MenuItem Header="_Build ROM" Click="OnBuild" InputGesture="Ctrl+B"/>
        <MenuItem Header="Export _BPS patch" Click="OnExportBps"/>
        <Separator/>
        <MenuItem Header="Set vanilla ROM…" Click="OnSetVanilla"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="OnUndo" InputGesture="Ctrl+Z"/>
        <MenuItem Header="_Redo" Click="OnRedo" InputGesture="Ctrl+Y"/>
      </MenuItem>
      <MenuItem Header="_Level">
        <MenuItem Header="_Properties…" Click="OnLevelProperties" InputGesture="Ctrl+L"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _palette" Click="OnTogglePalette" InputGesture="Ctrl+P"/>
        <MenuItem Header="Screen _grid" Click="OnToggleGrid" InputGesture="Ctrl+G"/>
      </MenuItem>
    </Menu>

    <!-- Header: canvas-mode toggle + per-mode controls -->
    <Border DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1" Padding="10,7">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton x:Name="ModeLevel" Classes="mode" Content="Level" IsChecked="True" Click="OnMode"/>
        <ToggleButton x:Name="ModeMap16" Classes="mode" Content="Map16" Click="OnMode"/>
        <ToggleButton x:Name="ModeGfx"   Classes="mode" Content="GFX"   Click="OnMode"/>

        <Rectangle Width="1" Margin="10,3" Fill="{DynamicResource BorderBrush}"/>

        <TextBlock Classes="dim" Text="level"/>
        <ComboBox x:Name="LevelBox" Width="96"/>

        <TextBlock Classes="dim" Text="zoom" Margin="10,0,0,0"/>
        <Slider x:Name="ZoomSlider" Width="140" Minimum="1" Maximum="8" Value="2"
                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        <TextBlock x:Name="ZoomLabel" Classes="mono" Width="26"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0" Padding="12,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Status" Classes="dim" Text="no ROM loaded — File ▸ Open ROM"/>
        <TextBlock x:Name="Hover" Grid.Column="1" Classes="mono"/>
      </Grid>
    </Border>

    <!-- Drawer | splitter | canvas. A Grid rather than a docked panel so the drawer can be
         dragged to whatever width the work needs. -->
    <Grid x:Name="Split" ColumnDefinitions="420,Auto,*">

      <Border x:Name="Drawer" Classes="panel" BorderThickness="0,0,1,0">
        <DockPanel>
          <TabStrip x:Name="PaletteTabs" DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}">
            <TabStripItem Content="Map16" IsSelected="True"/>
            <TabStripItem Content="Sprites"/>
            <TabStripItem Content="Objects"/>
          </TabStrip>

          <Border x:Name="PaletteBar" DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="dim" Text="bank"/>
              <ComboBox x:Name="BankBox" Width="74" SelectedIndex="0">
                <ComboBoxItem Content="0 FG"/>
                <ComboBoxItem Content="1 FG"/>
                <ComboBoxItem Content="2 BG"/>
              </ComboBox>
              <TextBlock Classes="dim" Text="size" Margin="8,0,0,0"/>
              <Slider x:Name="TileZoom" Width="90" Minimum="1" Maximum="4" Value="2"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
              <TextBlock x:Name="SelLabel" Classes="mono" Margin="6,0,0,0"/>
            </StackPanel>
          </Border>

          <!-- The drawer follows the canvas mode: Map16 tiles for the level, 8x8 GFX for
               the Map16 editor. Pick here, stamp there — one grammar at both levels. -->
          <Panel>
            <ScrollViewer x:Name="PaletteScroll" HorizontalScrollBarVisibility="Auto">
              <ui:Map16PaletteView x:Name="Palette" Margin="8"/>
            </ScrollViewer>
            <DockPanel x:Name="ChrPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="dim" Text="palette"/>
                  <ComboBox x:Name="PalRowBox" Width="66" SelectedIndex="2"/>
                  <CheckBox x:Name="ChrFlipX" Content="X"/>
                  <CheckBox x:Name="ChrFlipY" Content="Y"/>
                  <CheckBox x:Name="ChrPrio" Content="Pri"/>
                </StackPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <ui:ChrPaletteView x:Name="Chr" Margin="8"/>
              </ScrollViewer>
            </DockPanel>

            <!-- Sprite catalog: pick here, RIGHT-click the level to place. Sprites whose GFX
                 this level does not load are shown greyed rather than hidden — they still
                 place, they just draw as garbage until the GFX slots are changed. -->
            <DockPanel x:Name="SpritePanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox x:Name="LoadedOnly" Content="Loaded only" IsChecked="True"/>
                  <TextBlock x:Name="SpFiles" Classes="mono"/>
                </StackPanel>
              </Border>
              <ListBox x:Name="SpriteList" Classes="catalog" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="{Binding Thumb}" Width="32" Height="32" Stretch="None"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock Text="GFX not loaded" FontSize="10" IsVisible="{Binding !Loaded}"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Object catalog: thumbnails are composed from the cells each object really
                 writes in THIS tileset, so an irregular object looks like itself. -->
            <DockPanel x:Name="ObjectPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <TextBlock x:Name="ObjectHint" Classes="dim" TextWrapping="Wrap"/>
              </Border>
              <ListBox x:Name="ObjectList" Classes="catalog" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="{Binding Thumb}" Width="48" Height="48" Stretch="None"/>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

      <!-- Canvas modes share the region: exactly one is visible, and the drawer keeps
           feeding whichever it is. -->
      <Panel Grid.Column="2">
        <ScrollViewer x:Name="CanvasScroll"
                      Background="{DynamicResource VoidBrush}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ui:LevelView x:Name="Canvas"/>
        </ScrollViewer>
        <ScrollViewer x:Name="Map16Scroll" IsVisible="False"
                      Background="{DynamicResource VoidBrush}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ui:Map16CanvasView x:Name="Map16Canvas" Margin="8"/>
        </ScrollViewer>
      </Panel>
    </Grid>

  </DockPanel>
</Window>
