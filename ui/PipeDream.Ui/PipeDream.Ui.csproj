<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PipeDream.Ui</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PipeDream.Ui.Tests" />
  </ItemGroup>

  <!--
    The ONLY project reference: the services layer. This window draws and takes input; it does
    not open files, read ROM bytes or decide what an edit means. PipeDream (the storage layer)
    is reachable transitively for the domain records that travel across the boundary — a level
    header, an object, a sprite — but calling into it from here is a layering violation, and
    ArchitectureTests fails the build's test run if one appears.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\services\PipeDream.Services\PipeDream.Services.csproj" />
  </ItemGroup>

  <!-- Every file in this project talks to the services layer, so it is a global using rather
       than the same line at the top of twenty files. -->
  <ItemGroup>
    <Using Include="PipeDream.Services" />
  </ItemGroup>

</Project>
