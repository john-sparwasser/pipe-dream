# Build output
bin/
obj/

# Generated graphify knowledge-graph output (rebuild with ./refresh-graph.ps1)
graphify-out/

# Bulk third-party reference material — regenerable, not redistributed.
# Disassembly is split from a local dump; LM help is decompiled from Lunar Magic.chm.
reference/smw-disasm/*.asm
reference/smw-disasm/index.txt
reference/smw-disasm/graph/
reference/lm-help/

# Never commit copyrighted game data
*.smc
*.sfc
*.sfc.bak

# Local Claude Code state (settings, and the worktree backstop: worktrees belong OUTSIDE
# the repo, see CLAUDE.md — a nested one is a second full checkout that `git add -A`
# would otherwise try to commit).
.claude/

# Editor / UI state
imgui.ini
*.user
*.png

# Avalonia UI project build output
ui/**/bin/
ui/**/obj/

# Local dev project (created by the --dev F5 launch; never shared)
/dev/
