<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PipeDream.Ui.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- avares:// addresses the ASSEMBLY, which is PipeDream even though the project is
             PipeDream.Ui — renaming one without the other is a build error, not a silent miss. -->
        <ResourceInclude Source="avares://PipeDream/ui/Theme.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    <!-- Primary and destructive buttons, app-wide so every dialog's main action looks the same:
         Classes="accent" is the one filled accent action in a window (Apply, OK, Create);
         Classes="danger" is a ghost button that turns rose on hover (Remove, Delete). -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerFillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <!-- Mode toggles: a row of ToggleButtons acting as radio buttons (the main toolbar's
         level/map16/gfx switch, the GFX browser's view switch). App-wide because more than
         one window draws them, and two copies of a style drift. -->
    <Style Selector="ToggleButton.mode">
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="MinWidth" Value="82"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ToggleButton.mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <!-- Mode icons follow the label's colour states; stroked because Lucide is stroked. The
         Button half covers header buttons that carry an icon without being a mode (Course Bot). -->
    <Style Selector="ToggleButton.mode Path, Button.mode Path">
      <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked Path">
      <Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <!-- A stroked icon that is also filled, for tools whose variant IS "filled" (the Rect
         tool). Lucide has no filled set; a closed path plus this class is the whole trick. -->
    <Style Selector="ToggleButton.mode Path.filled">
      <Setter Property="Fill" Value="{DynamicResource TextDimBrush}"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked Path.filled">
      <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <!-- Popup content must be styled HERE, not in a window: a flyout is its own top level, so
         window styles never reach it and an unstyled Path has neither stroke nor fill — i.e.
         it draws nothing at all. -->
    <Style Selector="MenuItem Path">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <!-- A flyout holding nothing but a row of icon buttons: the theme's presenter is sized for
         menus, so strip its minimum and padding down to the buttons themselves. -->
    <Style Selector="FlyoutPresenter.picker">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MaxWidth" Value="240"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Narrower than the bar's toggles: these are two icons side by side, not labelled modes,
         so the 16px side padding that suits the bar just pads dead space here. -->
    <Style Selector="FlyoutPresenter.picker ToggleButton.mode">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Application.Styles>
</Application>
