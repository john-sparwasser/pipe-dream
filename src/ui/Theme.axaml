<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    One place for every colour, so the editor can be re-skinned without hunting hex literals
    through XAML. Chosen to keep attention on the CANVAS: chrome is low-contrast neutral grey,
    the artwork is the only saturated thing on screen, and the single accent marks "what you
    are editing right now".

    The palette is pipedream.nexus's: near-black surfaces with no blue cast, hairline borders,
    soft lavender-white text, and the original Pipe Dream blue as the accent, bright enough to pop
    against the near-black chrome; #4092E6 is the hover and Light1.
  -->

  <!-- surfaces, darkest (the void behind the level) to lightest (raised controls) -->
  <Color x:Key="VoidColor">#0B0B0C</Color>
  <Color x:Key="SurfaceColor">#0F0F11</Color>
  <Color x:Key="PanelColor">#121214</Color>
  <Color x:Key="RaisedColor">#1C1C20</Color>
  <Color x:Key="BorderColor">#26262B</Color>

  <!-- text -->
  <Color x:Key="TextColor">#E3E1EA</Color>
  <Color x:Key="TextDimColor">#888890</Color>
  <Color x:Key="TextFaintColor">#5A5A62</Color>

  <!-- One accent for "active", a lighter tint for hover, and a brighter cyan for
       selection rings on the canvas so they read against the artwork. -->
  <Color x:Key="AccentColor">#2E7FD4</Color>
  <Color x:Key="AccentHoverColor">#4092E6</Color>
  <Color x:Key="SelectionColor">#4FC1E9</Color>

  <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
  <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>

  <!-- Text and glyphs ON the blue accent: white. -->
  <SolidColorBrush x:Key="OnAccentBrush" Color="White"/>

  <!-- Checkbox ticks sit on the blue fill, so they take the same white. -->
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="White"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="White"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="White"/>

  <!-- Disabled buttons, app-wide: a ghost with faint text, so a dialog's unavailable actions recede
       instead of reading as grey slabs. -->
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#04FFFFFF"/>
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5A5A62"/>
  <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#04FFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#5A5A62"/>
  <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="Transparent"/>
  <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled" Color="Transparent"/>
  <SolidColorBrush x:Key="RepeatButtonForegroundDisabled" Color="#3A3A40"/>
  <SolidColorBrush x:Key="RepeatButtonBackground" Color="Transparent"/>
  <SolidColorBrush x:Key="RepeatButtonBackgroundPointerOver" Color="#14FFFFFF"/>

  <!-- One monospace stack for numbers, addresses, hex and file names, app-wide: the bundled
       JetBrains Mono, the same face pipedream.nexus uses. -->
  <FontFamily x:Key="MonoFont">avares://PipeDream/assets/fonts#JetBrains Mono, Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

  <!-- Status, used sparingly: green "done/ok", amber "careful", rose "destructive/error". -->
  <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#F5B544"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#F58D9C"/>
  <SolidColorBrush x:Key="DangerHoverBrush" Color="#F8A8B4"/>
  <SolidColorBrush x:Key="DangerFillBrush" Color="#2AF58D9C"/>

  <!-- Fluent's own tokens, repointed so stock controls inherit the palette instead of
       fighting it. Without this the combo boxes and menus stay default-blue.

       MIND THE TYPE. Fluent's SystemAccentColor* keys are Color resources, not brushes: its
       templates do Color="{DynamicResource SystemAccentColorLight1}", so handing them a
       SolidColorBrush throws InvalidCastException the moment a control resolves the style —
       which is on pointer-over, not at startup, so it looks like a random crash while using
       the app. Keys ending in "Brush" take a brush; the rest take a Color. -->
  <Color x:Key="SystemAccentColor">#2E7FD4</Color>
  <Color x:Key="SystemAccentColorLight1">#4092E6</Color>
  <Color x:Key="SystemAccentColorLight2">#5FA8EE</Color>
  <Color x:Key="SystemAccentColorLight3">#87C0F4</Color>
  <Color x:Key="SystemAccentColorDark1">#2569AF</Color>
  <Color x:Key="SystemAccentColorDark2">#1D538B</Color>
  <Color x:Key="SystemAccentColorDark3">#153E68</Color>

  <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{StaticResource PanelColor}"/>

  <!-- Menus, flyouts and drop-downs sit on the panel colour behind a hairline, like the site's
       cards, rather than on Fluent's lighter chrome grey. -->
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource RaisedColor}"/>
  <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}"/>

  <!-- Buttons, toggles, combo boxes and text fields are the site's ghost buttons: a faint white
       wash over the panel and a hairline that brightens on hover, instead of Fluent's solid grey
       slabs. Alpha, not a fixed grey, so they read the same on any surface they sit on. -->
  <SolidColorBrush x:Key="ButtonBackground" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF"/>
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4DFFFFFF"/>
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#08FFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#4DFFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBackground" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4DFFFFFF"/>
  <SolidColorBrush x:Key="TextControlBackground" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource VoidColor}"/>
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4DFFFFFF"/>

  <!-- Softer corners: the site's cards are 12px round and its controls nearly pills. Controls
       stay at 6 so a dense toolbar still reads as a grid; overlays take the cards' 12. -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

</ResourceDictionary>
