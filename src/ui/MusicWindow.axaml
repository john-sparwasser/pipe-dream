<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.MusicWindow"
        Title="Music" Width="700" Height="760" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.colhead">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="ListBox.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="ListBox.panel ListBoxItem">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Import music folder…" Click="OnImportFolder"
                ToolTip.Tip="Reads AddmusicK's own folder: its songs, samples, sound effects, groups and list"/>
        <Button Content="Export music folder…" Click="OnExportFolder"
                ToolTip.Tip="Writes the project's music as a folder AddmusicK itself can use"/>
      </StackPanel>
      <TextBlock x:Name="Hint" Grid.Column="1" Classes="dim" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" TextAlignment="Right" Margin="8,0"/>
      <Button Grid.Column="2" Content="Close" Click="OnClose" IsCancel="True"/>
    </Grid>

    <!-- Samples take the lower part; the songs, which are what one comes here for, the rest. -->
    <DockPanel DockPanel.Dock="Bottom" Height="104" Margin="0,16,0,0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <TextBlock Text="Samples" Classes="head"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Import sample…" Click="OnImportSample"
                ToolTip.Tip="Adds a .brr sample or a .bnk bank"/>
        <Button x:Name="DeleteSampleButton" IsVisible="{Binding !!#SampleList.ItemCount}" Classes="danger" Content="Delete" Click="OnDeleteSample" IsEnabled="False"/>
        </StackPanel>
      </Grid>
      <Grid>
        <ListBox x:Name="SampleList" Classes="panel" SelectionChanged="OnSelect">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,80" ColumnSpacing="12">
                <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Path}"/>
                <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="mono" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" TextAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="dim" Text="No custom samples" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !#SampleList.ItemCount}"/>
      </Grid>
    </DockPanel>

    <!-- Sound effects above the samples: a slot the project fills replaces SMW's effect there. -->
    <DockPanel DockPanel.Dock="Bottom" Height="128" Margin="0,16,0,0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
        <TextBlock Text="Sound effects" Classes="head"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Import effect…" Click="OnImportEffect"
                ToolTip.Tip="Puts an AddmusicK effect (.txt) in a slot of $1DF9 or $1DFC; the slots left empty play SMW's own"/>
        <Button x:Name="EditEffectButton" IsVisible="{Binding !!#EffectList.ItemCount}" Content="Edit…" Click="OnEditEffect" IsEnabled="False"/>
        <Button x:Name="DeleteEffectButton" IsVisible="{Binding !!#EffectList.ItemCount}" Classes="danger" Margin="8,0,0,0" Content="Clear slot" Click="OnDeleteEffect" IsEnabled="False"
                ToolTip.Tip="Empties the slot: SMW's own effect plays there again"/>
        </StackPanel>
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="64,*,80" ColumnSpacing="12" Margin="13,0,13,4"
            IsVisible="{Binding !!#EffectList.ItemCount}">
        <TextBlock Text="Slot" Classes="colhead"/>
        <TextBlock Grid.Column="1" Text="File" Classes="colhead"/>
        <TextBlock Grid.Column="2" Text="Size" Classes="colhead" TextAlignment="Right"/>
      </Grid>
      <Grid>
        <ListBox x:Name="EffectList" Classes="panel" SelectionChanged="OnSelect" DoubleTapped="OnEditEffect">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="64,*,80" ColumnSpacing="12">
                <TextBlock Text="{Binding Where}" Classes="mono"/>
                <TextBlock Grid.Column="1" Text="{Binding File}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding File}"/>
                <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="mono" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" TextAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="dim" Text="No custom sound effects — SMW's play in every slot" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !#EffectList.ItemCount}"/>
      </Grid>
    </DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
      <TextBlock Text="Songs" Classes="head"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="accent" Foreground="{DynamicResource OnAccentBrush}" Content="New…" Click="OnNew" ToolTip.Tip="Adds a song from the template"/>
        <Button Content="Import song…" Click="OnImportSong"
                ToolTip.Tip="Adds .mml/.txt songs from disk, with the samples each names from beside it"/>
        <Button x:Name="EditButton" Content="Edit…" Click="OnEdit" IsEnabled="False"/>
        <Button x:Name="NumberButton" Content="Set number…" Click="OnNumber" IsEnabled="False"
                ToolTip.Tip="The number and section the song is inserted under"/>
        <Button x:Name="DeleteButton" Classes="danger" Margin="8,0,0,0" Content="Delete" Click="OnDelete" IsEnabled="False"/>
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,80,80" ColumnSpacing="12" Margin="13,12,13,4">
      <TextBlock Text="Song" Classes="colhead"/>
      <TextBlock Grid.Column="1" Text="Number" Classes="colhead" TextAlignment="Right"/>
      <TextBlock Grid.Column="2" Text="Size" Classes="colhead" TextAlignment="Right"/>
    </Grid>

    <Grid>
    <ListBox x:Name="SongList" Classes="panel" SelectionChanged="OnSelect" DoubleTapped="OnEdit">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <!-- path, number and section, compiled size -->
          <Grid ColumnDefinitions="*,80,80" ColumnSpacing="12">
            <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Path}"/>
            <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="mono" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" TextAlignment="Right"
                       IsVisible="{Binding Number, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       ToolTip.Tip="Insert number and section"/>
            <TextBlock Grid.Column="1" Text="unassigned" Classes="mono" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" TextAlignment="Right"
                       IsVisible="{Binding Number, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                       ToolTip.Tip="Insert number and section"/>
            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="mono" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" TextAlignment="Right"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Classes="dim" Text="No songs yet — use New… or Import song…" IsHitTestVisible="False"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !#SongList.ItemCount}"/>
    </Grid>
  </DockPanel>
</Window>
