<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.MusicWindow"
        Title="Music" Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="Hint" Classes="dim" TextWrapping="Wrap" MaxWidth="500"/>
      <Button Content="Close" Click="OnClose" IsCancel="True"/>
    </StackPanel>

    <!-- Samples take the lower part; the songs, which are what one comes here for, the rest. -->
    <DockPanel DockPanel.Dock="Bottom" Height="170" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <TextBlock Text="Samples" Classes="head" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Content="Import sample…" Click="OnImportSample"
                ToolTip.Tip="Adds a .brr sample or a .bnk bank"/>
        <Button x:Name="DeleteSampleButton" Content="Delete" Click="OnDeleteSample" IsEnabled="False"/>
      </StackPanel>
      <ListBox x:Name="SampleList" SelectionChanged="OnSelect">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Path}" Classes="mono"/>
              <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="dim"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
      <Button Content="New…" Click="OnNew" ToolTip.Tip="Adds a song from the template"/>
      <Button Content="Import song…" Click="OnImportSong"
              ToolTip.Tip="Adds .mml/.txt songs from disk, with the samples each names from beside it"/>
      <Button x:Name="EditButton" Content="Edit…" Click="OnEdit" IsEnabled="False"/>
      <Button x:Name="NumberButton" Content="Number…" Click="OnNumber" IsEnabled="False"
              ToolTip.Tip="The number and section the song is inserted under"/>
      <Button x:Name="DeleteButton" Content="Delete" Click="OnDelete" IsEnabled="False"/>
      <Button Content="Import AddmusicK folder…" Click="OnImportFolder"
              ToolTip.Tip="Reads AddmusicK's own folder: its songs, samples, sound effects, groups and list"/>
      <Button Content="Export AddmusicK folder…" Click="OnExportFolder"
              ToolTip.Tip="Writes the project's music as a folder AddmusicK itself can use"/>
    </StackPanel>

    <ListBox x:Name="SongList" Margin="0,10,0,0" SelectionChanged="OnSelect" DoubleTapped="OnEdit">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <!-- path, number and section, compiled size -->
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding Path}" Classes="mono"/>
            <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="dim"/>
            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="dim" MinWidth="80" TextAlignment="Right"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
