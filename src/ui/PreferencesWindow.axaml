<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.PreferencesWindow"
        Title="Preferences" Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">
  <Window.Styles>
    <Style Selector="TextBox.path">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.path:not(.unset)">
      <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style Selector="TextBox.path.unset">
      <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
    </Style>
  </Window.Styles>
  <!-- Each choice is saved as it is made; Use default goes back to what the app does unset. -->
  <StackPanel Margin="24" Spacing="24">
    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,16,Auto,Auto,Auto"
          ColumnSpacing="8" RowSpacing="8">
      <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Text editor" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
      <TextBox x:Name="EditorPath" Grid.Row="1" Classes="path" IsReadOnly="True" MinHeight="32"
               TextWrapping="NoWrap"/>
      <Button Grid.Row="1" Grid.Column="1" Content="Browse…" Click="OnBrowseEditor"
              MinHeight="32" Padding="12,0" VerticalContentAlignment="Center"/>
      <Button x:Name="DefaultEditorButton" Grid.Row="1" Grid.Column="2" Content="Reset" Click="OnDefaultEditor"
              MinHeight="32" Padding="12,0" VerticalContentAlignment="Center"
              ToolTip.Tip="Open blocks in whatever the OS opens .asm files with"/>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" FontSize="12"
                 Text="Custom blocks (.asm) open in this program."
                 Foreground="{DynamicResource TextDimBrush}"/>

      <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="Emulator" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
      <TextBox x:Name="EmulatorPath" Grid.Row="5" Classes="path" IsReadOnly="True" MinHeight="32"
               TextWrapping="NoWrap"/>
      <Button Grid.Row="5" Grid.Column="1" Content="Browse…" Click="OnBrowseEmulator"
              MinHeight="32" Padding="12,0" VerticalContentAlignment="Center"/>
      <Button x:Name="DefaultEmulatorButton" Grid.Row="5" Grid.Column="2" Content="Reset" Click="OnDefaultEmulator"
              MinHeight="32" Padding="12,0" VerticalContentAlignment="Center"
              ToolTip.Tip="Run in emulator (F4) looks for Mesen in the usual places"/>
      <TextBlock Grid.Row="6" Grid.ColumnSpan="3" FontSize="12"
                 Text="Used by Run in emulator (F4)."
                 Foreground="{DynamicResource TextDimBrush}"/>
    </Grid>
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="0,16,0,0">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Changes are saved automatically." VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource TextDimBrush}"/>
      <Button Grid.Column="1" Content="Close" Click="OnClose" IsCancel="True"
              MinHeight="32" Padding="16,0" VerticalContentAlignment="Center"/>
    </Grid>
    </Border>
  </StackPanel>
</Window>
