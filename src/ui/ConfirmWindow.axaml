<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.ConfirmWindow"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap"
               Foreground="{DynamicResource TextBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="Cancel" Content="Cancel" Click="OnCancel" IsCancel="True"/>
      <Button x:Name="Action" Click="OnConfirm" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
