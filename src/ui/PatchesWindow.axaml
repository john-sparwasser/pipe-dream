<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.PatchesWindow"
        Title="Patches" Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <!-- The Custom blocks window's bar, plus the order: patches apply top to bottom, so where one
         sits in the list is part of what it does. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
      <Button Content="New…" Click="OnNew" ToolTip.Tip="Adds a patch from the template"/>
      <Button Content="Import…" Click="OnImport"
              ToolTip.Tip="Adds .asm patches from disk, with every file each one includes from beside it"/>
      <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" IsEnabled="False"/>
      <Button x:Name="EditButton" Content="Edit" Click="OnEdit" IsEnabled="False"/>
      <Button x:Name="OpenButton" Click="OnOpen" IsEnabled="False"
              ToolTip.Tip="Open the patch in your text editor (File ▸ Preferences); saving there updates the project"/>
      <Button x:Name="UpButton" Content="Move up" Click="OnUp" IsEnabled="False"
              ToolTip.Tip="Apply this patch earlier"/>
      <Button x:Name="DownButton" Content="Move down" Click="OnDown" IsEnabled="False"
              ToolTip.Tip="Apply this patch later"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="Hint" Classes="dim" TextWrapping="Wrap" MaxWidth="500"/>
      <Button Content="Close" Click="OnClose" IsCancel="True"/>
    </StackPanel>

    <ListBox x:Name="List" Margin="0,10,0,0" SelectionChanged="OnSelect" DoubleTapped="OnEdit">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <!-- on/off, name, description (the patch's first comment line), how many files it includes -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" MinWidth="0" Padding="0"
                      ToolTip.Tip="Applied at build when ticked; kept in the project either way"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono"/>
            <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="dim" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Description}"/>
            <TextBlock Grid.Column="3" Text="{Binding Note}" Classes="note"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
