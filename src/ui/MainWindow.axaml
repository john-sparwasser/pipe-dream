<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PipeDream.Ui"
        x:Class="PipeDream.Ui.MainWindow"
        Title="pipe-dream" Width="1500" Height="900"
        Icon="/assets/pipe-icon-64.png"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Resources>
    <!-- Lucide icons (ISC), path data verbatim except circles/rects rewritten as arcs and
         leading relative 'm' made absolute so subpaths survive concatenation. Lucide is
         stroke-drawn, so these render via Path + Stroke, not PathIcon (which fills). -->
    <StreamGeometry x:Key="IconTentTree">M6 4A2 2 0 1 1 2 4A2 2 0 1 1 6 4 M14 5l3-3 3 3 M14 10l3-3 3 3 M17 14V2 M17 14H7l-5 8h20Z M8 14v8 M9 14l5 8</StreamGeometry>
    <StreamGeometry x:Key="IconGrid3x3">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2 M3 9h18 M3 15h18 M9 3v18 M15 3v18</StreamGeometry>
    <!-- Lucide "film" — the Animations mode. -->
    <StreamGeometry x:Key="IconFilm">M18 3v18 M3 7.5h4 M3 12h18 M3 16.5h4 M17 7.5h4 M17 16.5h4 M6 3v18 M3 3h18a0 0 0 0 1 0 0v18a0 0 0 0 1 0 0H3a0 0 0 0 1 0 0V3a0 0 0 0 1 0 0z</StreamGeometry>
    <StreamGeometry x:Key="IconSquarePen">M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z</StreamGeometry>
    <StreamGeometry x:Key="IconBird">M16 7h.01 M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7.28-2.3L2 20 M20 7l2 .5-2 .5 M10 18v3 M14 17.75V21 M7 18a6 6 0 0 0 3.84-10.61</StreamGeometry>
    <StreamGeometry x:Key="IconScanBox">M12 12v5.5 M17 3h2a2 2 0 0 1 2 2v2 M21 17v2a2 2 0 0 1-2 2h-2 M3 7V5a2 2 0 0 1 2-2h2 M7 21H5a2 2 0 0 1-2-2v-2 M7.264 9.252 12 12l4.737-2.748 M7.995 8.514A2 2 0 0 0 7 10.244v3.516a2 2 0 0 0 .996 1.73l3 1.74a2 2 0 0 0 2.008 0l3-1.74A2 2 0 0 0 17 13.76v-3.517a2 2 0 0 0-.995-1.73l-3-1.742a2 2 0 0 0-1.892-.064z</StreamGeometry>
    <StreamGeometry x:Key="IconFolderSearch">M11 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H19a2 2 0 0 1 2 2v1.5 M20 17A3 3 0 1 1 14 17A3 3 0 1 1 20 17 M21 21l-1.9-1.9</StreamGeometry>
    <StreamGeometry x:Key="IconPencil">M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z M15 5l4 4</StreamGeometry>
    <StreamGeometry x:Key="IconPaintBucket">M19 11l-8-8-8.6 8.6a2 2 0 0 0 0 2.8l5.2 5.2c.8.8 2 .8 2.8 0L19 11Z M5 2l5 5 M2 13h15 M22 20a2 2 0 1 1-4 0c0-1.6 1.7-2.4 2-4 .3 1.6 2 2.4 2 4Z</StreamGeometry>
    <StreamGeometry x:Key="IconEraser">M7 21l-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21 M22 21H7 M5 11l9 9</StreamGeometry>
    <StreamGeometry x:Key="IconMousePointer2">M4 4l7.07 17 2.51-7.39L21 11.07Z</StreamGeometry>
    <StreamGeometry x:Key="IconPipette">M2 22l1-1h3l9-9 M3 21v-3l9-9 M15 6l3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-8a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v8 M7 3v4a1 1 0 0 0 1 1h7</StreamGeometry>
    <StreamGeometry x:Key="IconCircleCheck">M22 12A10 10 0 1 1 2 12A10 10 0 1 1 22 12 M9 12l2 2 4-4</StreamGeometry>
    <StreamGeometry x:Key="IconCircle">M22 12A10 10 0 1 1 2 12A10 10 0 1 1 22 12</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z</StreamGeometry>
    <StreamGeometry x:Key="IconBot">M12 8V4H8 M6 8H18A2 2 0 0 1 20 10V18A2 2 0 0 1 18 20H6A2 2 0 0 1 4 18V10A2 2 0 0 1 6 8 M2 14h2 M20 14h2 M15 13v2 M9 13v2</StreamGeometry>
    <!-- Lucide `square`. Closed with Z so the same geometry can also be FILLED — Lucide ships
         no filled variant, but a stroked path that closes fills correctly, which is how the
         Rect tool shows its outline/filled state with one icon. -->
    <StreamGeometry x:Key="IconStickyNote">M16 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8Z M15 3v4a2 2 0 0 0 2 2h4</StreamGeometry>
    <StreamGeometry x:Key="IconSquareDashed">M5 3a2 2 0 0 0-2 2 M19 3a2 2 0 0 1 2 2 M21 19a2 2 0 0 1-2 2 M5 21a2 2 0 0 1-2-2 M9 3h1 M9 21h1 M14 3h1 M14 21h1 M3 9v1 M21 9v1 M3 14v1 M21 14v1</StreamGeometry>
    <StreamGeometry x:Key="IconFlower2">M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1 M14 8A2 2 0 1 1 10 8A2 2 0 1 1 14 8 M12 10v12 M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z</StreamGeometry>
    <StreamGeometry x:Key="IconSquare">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z</StreamGeometry>
    <StreamGeometry x:Key="IconLine">M4 20 19 5</StreamGeometry>
    <StreamGeometry x:Key="IconRotateCcw">M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5</StreamGeometry>
    <StreamGeometry x:Key="IconRotateCw">M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8 M21 3v5h-5</StreamGeometry>
    <StreamGeometry x:Key="IconFlipHorizontal">M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3 M16 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3 M12 2v2 M12 8v2 M12 14v2 M12 20v2</StreamGeometry>
    <StreamGeometry x:Key="IconFlipVertical">M21 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v3 M21 16v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3 M2 12h2 M8 12h2 M14 12h2 M20 12h2</StreamGeometry>
    <StreamGeometry x:Key="IconMountain">M8 3l4 8 5-5 5 15H2L8 3z</StreamGeometry>
    <StreamGeometry x:Key="IconMountainSnow">M8 3l4 8 5-5 5 15H2L8 3z M4.14 15.08c2.62-1.57 5.24-1.43 7.86.42 2.74 1.94 5.49 2 8.23.19</StreamGeometry>
    <StreamGeometry x:Key="IconDoorClosed">M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14 M2 20h20 M14 12v.01</StreamGeometry>
    <StreamGeometry x:Key="IconDoorOpen">M13 4h3a2 2 0 0 1 2 2v14 M2 20h3 M13 20h9 M10 12v.01 M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.562Z</StreamGeometry>
    <StreamGeometry x:Key="IconPalette">M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z M13.5 6.5h.01 M17.5 10.5h.01 M6.5 12.5h.01 M8.5 7.5h.01</StreamGeometry>
    <StreamGeometry x:Key="IconImage">M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M21 15l-5-5L5 21</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <!-- The header mode toggle's ToggleButton.mode styles live in App.axaml: the GFX browser's
         view switch draws the same control, and two copies of a style drift. -->
    <!-- Drawer tabs ARE the mode toggles, drawn by a TabStrip: same metrics, same accent pill,
         same icon treatment, so the drawer's header reads as one furniture with the mode bar
         above it. Their stroke binds to the item's Foreground, which the states below drive. -->
    <!-- Height, padding, corner and content centring come from the Border.bar rules below, the
         same ones the mode toggles get them from — the only way the two rows stay identical. -->
    <Style Selector="TabStrip#PaletteTabs TabStripItem">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="82"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <!-- Fluent's own template carries a selection underline that no setter can turn off, and
           chrome the mode toggles do not have. This is the pill and nothing else, so the two
           rows are the same control drawn twice rather than one imitating the other. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabStrip#PaletteTabs TabStripItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style Selector="TabStrip#PaletteTabs TabStripItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="TabStrip#PaletteTabs TabStripItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="TabStrip#PaletteTabs Path">
      <Setter Property="Stroke" Value="{Binding $parent[TabStripItem].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- One height for everything that sits in a toolbar row. Buttons, combos and text boxes
         all have different intrinsic heights, so a row of them lands on three different
         baselines unless they are pinned to one. 28px is what the mode toggles come out at. -->
    <Style Selector="Border.bar Button, Border.bar ToggleButton, Border.bar ComboBox,
                     Border.bar TextBox, Border.bar CheckBox, Border.bar TabStripItem">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- ToggleButton is in here for its PADDING as much as its shape: Fluent's default is
         5 top / 6 bottom, which sits a text label a pixel low and, on a toggle whose content is
         text rather than a 14px icon, pushes the whole row past the 28px it is supposed to be. -->
    <Style Selector="Border.bar Button, Border.bar ToggleButton,
                     Border.bar ComboBox, Border.bar TextBox, Border.bar TabStripItem">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <!-- A toolbar button's content sits in the middle of it. Fluent leaves the content STRETCHED,
         which for a label narrower than the button's MinWidth means the text is drawn against the
         left of a box the full width of the button — "8x8" in a 52px slot reads off-centre. -->
    <Style Selector="Border.bar Button, Border.bar ToggleButton, Border.bar TabStripItem">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- A bar text box is shorter than Fluent's 32px template expects, and the text presenter
         keeps Fluent's TOP alignment inside it, so the text lands where the font's ascent puts
         it: about centred with the Windows UI font, visibly high with the Mac's. Centring the
         presenter takes the font out of it. -->
    <Style Selector="Border.bar TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.bar Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.bar TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- The palette-row picker, one per canvas mode in the same gutter slot. One width for both,
         here rather than on each: they sit in the same place and must not drift apart. -->
    <Style Selector="ComboBox.palrow">
      <Setter Property="Width" Value="82"/>
    </Style>
    <!-- Separator between groups in a toolbar row, so the groups read as groups. -->
    <Style Selector="Rectangle.sep">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <!-- Lucide inside a toolbar button, same stroked treatment as the mode toggles. Greys with
         the button so a disabled Save reads as disabled icon and all. -->
    <Style Selector="Border.bar Button Path, Border.bar ToggleButton:not(.mode) Path">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.bar Button:disabled Path, Border.bar ToggleButton:not(.mode):disabled Path">
      <Setter Property="Stroke" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
    <!-- The one action an otherwise empty canvas offers: accent-filled, so it reads as the thing
         to press rather than as chrome. -->
    <Style Selector="Button.cta">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="20,11"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.cta Path">
      <Setter Property="Stroke" Value="White"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="17"/>
      <Setter Property="Height" Value="17"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- What a file IS, as a badge rather than a word: circle-check for one of the ROM's own,
         star (accented) for a custom ExGFX. -->
    <Style Selector="Path.kind">
      <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Path.kind.custom">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <!-- The name of the thing being edited: the loudest text in its bar. -->
    <Style Selector="TextBlock.subject">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Nothing selected greys the whole Map16 field row. Buttons, combos and text boxes grey
         themselves when disabled; a TextBlock does not, so its colour is done here — by STYLE
         rather than inline, since a local value would outrank the disabled one, and AFTER .mono
         and .dim, since the last matching style wins. -->
    <Style Selector="TextBlock#M16SelLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Border.bar TextBlock:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    <!-- Invisible, straddles the seam: the drawer's own 1px border is the only line between
         drawer and canvas, and the grab handle overhangs it on both sides.
         MinWidth 0 is the load-bearing part — Fluent floors a GridSplitter several pixels wide,
         which is what the negative margin has to cancel to leave the Auto column at 1px. The
         column stays Auto rather than absolute: an absolute width makes the splitter pin the
         canvas column, and then hiding the drawer cannot give the canvas the room back. -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="7"/>
      <Setter Property="Margin" Value="-3,0"/>
    </Style>
    <!-- Catalog rows are their own height (a 48px thumbnail), so the default item padding
         would waste half the drawer. -->
    <Style Selector="ListBox.catalog ListBoxItem">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <!-- HotKey, not InputGesture: an InputGesture is a caption Avalonia never wires up, and for
             years these were captions. A HotKey registers the key on the window and fires the item —
             menu closed or open — and the caption follows it. Platform-switched because a HotKey is
             one gesture: Ctrl here, Cmd on a Mac. Save/Undo/Redo stay in OnWindowKeyDown instead,
             which takes Ctrl AND Cmd on every platform; their gestures below are captions only. -->
        <MenuItem Header="_New Project…" Click="OnNewProject" HotKey="{OnPlatform Ctrl+N, macOS=Cmd+N}"/>
        <!-- New Project takes the configured vanilla ROM without asking, once there is one; this
             is how an existing hack (an .smc you already have) becomes a project's base. -->
        <MenuItem x:Name="NewProjectFromRomItem" Header="New Project from _ROM…" Click="OnNewProjectFromRom"
                  ToolTip.Tip="Start a project from an existing .smc — a hack in progress, or any ROM other than the vanilla one"/>
        <MenuItem Header="_Open Project…" Click="OnOpenProject" HotKey="{OnPlatform Ctrl+O, macOS=Cmd+O}"/>
        <MenuItem x:Name="RecentMenu" Header="_Recent Projects"/>
        <Separator/>
        <MenuItem Header="_Save" Click="OnSave" InputGesture="{OnPlatform Ctrl+S, macOS=Cmd+S}"/>
        <MenuItem Header="_Build ROM" Click="OnBuild" HotKey="{OnPlatform Ctrl+B, macOS=Cmd+B}"/>
        <MenuItem x:Name="RunEmulatorItem" Header="_Run in emulator" Click="OnRunEmulator" InputGesture="F4"/>
        <MenuItem Header="Export _BPS patch" Click="OnExportBps"/>
        <Separator/>
        <MenuItem x:Name="UpgradePrepItem" Header="Upgrade base prep" Click="OnUpgradePrep"/>
        <MenuItem Header="Set vanilla ROM…" Click="OnSetVanilla"/>
        <MenuItem Header="Set e_mulator…" Click="OnSetEmulator"/>
        <MenuItem Header="ROM _info…" Click="OnRomInfo"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="EditUndo" Header="_Undo" Click="OnUndo" InputGesture="{OnPlatform Ctrl+Z, macOS=Cmd+Z}"/>
        <MenuItem x:Name="EditRedo" Header="_Redo" Click="OnRedo" InputGesture="{OnPlatform Ctrl+Y, macOS=Cmd+Shift+Z}"/>
      </MenuItem>
      <MenuItem Header="_Level">
        <MenuItem Header="_Properties…" Click="OnLevelProperties" HotKey="{OnPlatform Ctrl+L, macOS=Cmd+L}"/>
        <MenuItem Header="_Reload from project" Click="OnReloadLevel" HotKey="{OnPlatform Ctrl+R, macOS=Cmd+R}"/>
        <!-- The whole exit TABLE, with the water/secondary flags and the way into the secondary
             entrance records. The canvas's Exits mode is the everyday route — it sets a
             destination per screen; this is for the parts a badge cannot show. -->
        <MenuItem Header="Screen e_xits…" Click="OnLevelExits"/>
        <!-- The selected sprite's number, extra bits and LM extra bytes — the one thing about a
             sprite the canvas cannot set by pointing. -->
        <MenuItem Header="Sprite _data…" Click="OnSpriteData"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ViewGridItem" Header="Screen _grid" Click="OnToggleGrid" HotKey="{OnPlatform Ctrl+G, macOS=Cmd+G}"/>
        <Separator/>
        <MenuItem x:Name="SpriteOverlayItem" Header="_Sprite overlay" Click="OnToggleSprites"/>
        <MenuItem x:Name="AnimateItem" Header="_Animate tiles" Click="OnToggleAnimate"/>
        <MenuItem x:Name="Layer3PreviewItem" Header="Layer _3 preview" Click="OnToggleLayer3Preview"
                  ToolTip.Tip="Draw this level's layer 3 on the level canvas — behind the level, or in front when the header gives it priority"/>
      </MenuItem>
      <!-- Only in a - -dev launch (the F5 profile): shortcuts for testing, never shipped UI. -->
      <MenuItem x:Name="DebugMenu" Header="De_bug" IsVisible="False">
        <MenuItem Header="_Clear project edits…" Click="OnClearProject"/>
        <MenuItem Header="Build and open in _Lunar Magic" Click="OnOpenLunarMagic"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _updates…" Click="OnCheckUpdates"/>
      </MenuItem>
    </Menu>

    <!-- Header: canvas-mode toggle + per-mode controls. Groups are separated by a rule and the
         controls inside share one height, so the row reads left to right as three groups rather
         than a dozen differently-sized buttons. -->
    <Border DockPanel.Dock="Top" Classes="panel bar" BorderThickness="0,0,0,1" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton x:Name="ModeLevel" Classes="mode" IsChecked="True" Click="OnMode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconTentTree}"/>
            <TextBlock Text="Level" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="ModeMap16" Classes="mode" Click="OnMode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconGrid3x3}"/>
            <TextBlock Text="Map16" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="ModeGfx" Classes="mode" Click="OnMode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconSquarePen}"/>
            <TextBlock Text="Graphics" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="ModePalette" Classes="mode" Click="OnMode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconPalette}"/>
            <TextBlock Text="Palette" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="ModeBg" Classes="mode" Click="OnMode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconImage}"/>
            <TextBlock Text="Background" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton x:Name="ModeAnim" Classes="mode" Click="OnMode">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconFilm}"/>
            <TextBlock Text="Animations" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>

        <!-- Not a mode: opens the course manager, so a Button rather than a toggle. -->
        <Button Classes="mode" Click="OnCourseBot"
                ToolTip.Tip="Organize entry levels by name — create, open and delete named courses">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{StaticResource IconBot}"/>
            <TextBlock Text="Courses" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Rectangle Classes="sep" Margin="10,4"/>

        <TextBlock Classes="dim" Text="level"/>
        <ComboBox x:Name="LevelBox" Width="104"/>
      </StackPanel>
    </Border>

    <!-- Status bar. Zoom lives down here rather than in the header, where Lunar Magic keeps it:
         it is a view setting, not an edit tool. Percent, in 10% steps — "2x" is a rendering
         detail, "120%" is what the user is choosing. -, = step it from anywhere. -->
    <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="*,Auto">
        <!-- What is under the cursor, in the current canvas's own terms. Blank when the cursor is
             elsewhere. -->
        <TextBlock x:Name="Readout" Classes="mono" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,16,0">
          <TextBlock Classes="dim" Text="zoom" VerticalAlignment="Center"/>
          <!-- Range and value are set from code per canvas mode (ApplyZoomTarget); these are
               only what the slider looks like before the window is wired up. -->
          <Slider x:Name="ZoomSlider" Width="130" Minimum="100" Maximum="800" Value="100"
                  TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                  ToolTip.Tip="Zoom for the canvas that is showing — or press - and = to step it"/>
          <TextBlock x:Name="ZoomLabel" Classes="mono" Width="40" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Drawer | splitter | canvas. A Grid rather than a docked panel so the drawer can be
         dragged to whatever width the work needs. -->
    <Grid x:Name="Split" ColumnDefinitions="420,Auto,*">

      <Border x:Name="Drawer" Classes="panel" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- The drawer's header, wearing the same bar the mode toggles and the other two
               drawers' headers wear. It follows the strip it holds, so a canvas mode that owns
               the drawer takes the whole strip away rather than leaving an empty rule. -->
          <!-- Height tracks the canvas bar beside it, the same deal the Map16 and GFX drawers
               have with their editor bars: a TabStrip measures a couple of pixels taller than
               a row of toggles, and the two headers have to read as one strip. -->
          <Border x:Name="LevelDrawerBar" DockPanel.Dock="Top" Classes="panel bar"
                  BorderThickness="0,0,0,1"
                  Padding="10,0" IsVisible="{Binding #PaletteTabs.IsVisible}"
                  Height="{Binding #LevelEditorBar.Bounds.Height}">
          <TabStrip x:Name="PaletteTabs" Background="Transparent" Padding="0"
                    VerticalAlignment="Center">
            <!-- The same 6px gap the mode bar's StackPanel puts between its toggles. -->
            <TabStrip.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6"/>
              </ItemsPanelTemplate>
            </TabStrip.ItemsPanel>
            <!-- GFX and Palette are NOT here: they are canvas modes, with their own drawers. -->
            <TabStripItem IsSelected="True">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconGrid3x3}"/>
                <TextBlock Text="Tiles" VerticalAlignment="Center"/>
              </StackPanel>
            </TabStripItem>
            <TabStripItem>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconBird}"/>
                <TextBlock Text="Sprites" VerticalAlignment="Center"/>
              </StackPanel>
            </TabStripItem>
            <TabStripItem>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconScanBox}"/>
                <TextBlock Text="Objects" VerticalAlignment="Center"/>
              </StackPanel>
            </TabStripItem>
          </TabStrip>
          </Border>

          <!-- The drawer follows the canvas mode: Map16 tiles for the level, 8x8 GFX for
               the Map16 editor. Pick here, stamp there — one grammar at both levels. -->
          <Panel>
            <DockPanel x:Name="TilesPanel">
              <!-- Which slice of the Map16 table this picker lists, and what is armed out of it.
                   A footer rather than a second header: the tabs already say what the drawer is
                   showing, and the bank is a setting on it, not another thing to read first. -->
              <Border x:Name="PaletteBar" DockPanel.Dock="Bottom" Classes="panel bar"
                      BorderThickness="0,1,0,0" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="dim" Text="bank" VerticalAlignment="Center"/>
                  <ComboBox x:Name="BankBox" Width="82" SelectedIndex="0">
                    <ComboBoxItem Content="0 FG"/>
                    <ComboBoxItem Content="1 FG"/>
                    <ComboBoxItem Content="2 BG"/>
                  </ComboBox>
                  <CheckBox x:Name="PagesBox" VerticalAlignment="Center"
                            ToolTip.Tip="Pages — outline and number each Map16 page">
                    <Path Data="{StaticResource IconStickyNote}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                          StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
                  </CheckBox>
                  <TextBlock x:Name="SelLabel" Classes="mono" Margin="4,0,0,0"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <ScrollViewer x:Name="PaletteScroll" HorizontalScrollBarVisibility="Disabled">
                <ui:Map16PaletteView x:Name="Palette" Margin="8"/>
              </ScrollViewer>
            </DockPanel>
            <DockPanel x:Name="ChrPanel" IsVisible="False">
              <!-- Height tracks the canvas bar so the two headers read as one strip, the same
                   deal the GFX drawer has with the GFX editor bar. -->
              <Border x:Name="Map16DrawerBar" DockPanel.Dock="Top" Classes="panel bar"
                      BorderThickness="0,0,0,1" Padding="10,0"
                      Height="{Binding #Map16EditorBar.Bounds.Height}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Classes="kind" Data="{StaticResource IconPalette}"/>
                  <TextBlock Classes="subject" Text="8x8 graphics"/>
                </StackPanel>
              </Border>
              <!-- Vertical only: the grid sizes its tiles to the width it is given, so there is
                   never anything to scroll sideways to — and offering the axis would hand it an
                   infinite width to measure against. -->
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ui:ChrPaletteView x:Name="Chr" Margin="8"/>
              </ScrollViewer>
            </DockPanel>

            <!-- Sprite catalog: pick here, RIGHT-click the level to place. Sprites whose GFX
                 this level does not load are shown greyed rather than hidden — they still
                 place, they just draw as garbage until the GFX slots are changed. -->
            <DockPanel x:Name="SpritePanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox x:Name="LoadedOnly" Content="Loaded only" IsChecked="True"/>
                  <TextBlock x:Name="SpFiles" Classes="mono"/>
                </StackPanel>
              </Border>
              <ListBox x:Name="SpriteList" Classes="catalog" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="{Binding Thumb}" Width="32" Height="32" Stretch="None"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock Text="GFX not loaded" FontSize="10" IsVisible="{Binding !Loaded}"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Object catalog: thumbnails are composed from the cells each object really
                 writes in THIS tileset, so an irregular object looks like itself. -->
            <DockPanel x:Name="ObjectPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <TextBlock x:Name="ObjectHint" Classes="dim" TextWrapping="Wrap"/>
              </Border>
              <ListBox x:Name="ObjectList" Classes="catalog" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="{Binding Thumb}" Width="48" Height="48" Stretch="None"/>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Palette: the level's CGRAM, edited in the SNES's own colour space. Five bits per
                 channel is what the hardware stores, so sliders of 0-31 are exact where a
                 24-bit picker would quantise behind your back. -->
            <DockPanel x:Name="PalettePanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="PaletteNote" Classes="dim" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PaletteIndex" Classes="mono" Width="150"/>
                    <Button x:Name="PaletteReset" Content="Reset" Padding="10,2" Click="OnResetPalette"/>
                    <!-- Layer 3 can reach 32 of these 256, and hunting for them in a 16x16 block
                         is the whole problem. Four wide by eight tall over CGRAM 00-1F puts one
                         palette GROUP on each row, which is also the shape of the answer to
                         "which palettes can layer 3 use". -->
                    <CheckBox x:Name="PaletteLayer3" Content="Layer 3"
                              IsCheckedChanged="OnPaletteLayer3Only"
                              ToolTip.Tip="Show only CGRAM 00-1F — the 32 colours a 2bpp layer-3 tile can name, one palette group per row"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- Colour 0 is the back area colour, broken out on its own: in the grid it reads
                   as just another swatch, and it is the one people hunt for. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,8,8,0">
                <ui:PaletteGridView x:Name="PaletteBg" Cols="1" Rows="1"/>
                <TextBlock Classes="dim" Text="Background Color" VerticalAlignment="Center"/>
              </StackPanel>
              <!-- Sideways scrolling disabled so the width is a real constraint: the grid fits it. -->
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ui:PaletteGridView x:Name="PaletteGrid" Margin="8"/>
              </ScrollViewer>
            </DockPanel>

            <!-- Background mode's drawer: the BG Map16 tiles the background can address. These
                 are the fixed 0x200 defs at $0D9100 — LM's BG pages 80-81, a different table
                 from the FG Map16 the level objects use. -->
            <DockPanel x:Name="BgToolPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Classes="panel bar" BorderThickness="0,0,0,1"
                      Padding="10,0" Height="{Binding #BgEditorBar.Bounds.Height}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Classes="kind" Data="{StaticResource IconGrid3x3}"/>
                  <TextBlock x:Name="BgDrawerTitle" Classes="subject" Text="BG Map16"/>
                </StackPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ui:TilemapView x:Name="BgSheet" Margin="8"/>
              </ScrollViewer>
            </DockPanel>

            <!-- GFX canvas mode's drawer: SELECTING a file and EDITING it are one screen. The
                 paint colours sit at the top, then the level's ten VRAM bins — each showing what
                 it holds, previewing it, and repointable by id, by file, or by raw .bin import.
                 Clicking a bin opens it in the editor beside it, so there is no separate tab to
                 go to and come back from. -->
            <DockPanel x:Name="GfxToolPanel" IsVisible="False">
              <!-- The open file's identity lives here, not in the editor bar: over there its
                   varying width nudged the tool buttons. Height tracks the editor bar so the
                   two headers read as one strip. -->
              <Border DockPanel.Dock="Top" Classes="panel bar" BorderThickness="0,0,0,1"
                      Padding="10,0" Height="{Binding #GfxEditorBar.Bounds.Height}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Header" VerticalAlignment="Center"
                          Click="OnGfxHeader"
                          ToolTip.Tip="Which FG/BG tileset and sprite set this level's header loads"/>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path x:Name="GfxKind" Classes="kind"/>
                    <TextBlock x:Name="GfxFileName" Classes="subject"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <ScrollViewer>
                <StackPanel x:Name="GfxBins" Margin="10,6" Spacing="10"/>
              </ScrollViewer>
            </DockPanel>

            <!-- Animations canvas mode's drawer: the graphics manager for the animation
                 source area (AN2 / the 0x600-based ExAnimation frame tiles). Same skeleton as
                 the GFX drawer: a header strip tracking the editor bar, then a card list.
                 ponytail: skeleton — the list is filled by RefreshAnim, empty until then. -->
            <DockPanel x:Name="AnimToolPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Classes="panel bar" BorderThickness="0,0,0,1"
                      Padding="10,0" Height="{Binding #AnimEditorBar.Bounds.Height}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Path Classes="kind" Data="{StaticResource IconFilm}"/>
                  <TextBlock x:Name="AnimListTitle" Classes="subject" Text="Slots"/>
                </StackPanel>
              </Border>
              <ScrollViewer>
                <StackPanel x:Name="AnimGfx" Margin="10,6" Spacing="10"/>
              </ScrollViewer>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns"/>

      <DockPanel Grid.Column="2">

      <!-- GFX paint colours, at the bottom right of the canvas rather than up in the drawer: the
           swatch you pick and the pixel you place it on belong next to each other, and this puts
           them one row above the zoom gutter instead of across the window. -->
      <Border x:Name="GfxPaletteBar" DockPanel.Dock="Bottom" Classes="panel bar" IsVisible="False"
              BorderThickness="0,1,0,0" Padding="10,6">
        <DockPanel LastChildFill="False">
          <!-- The depth this file is READ at. It follows the file (layer-3 graphics are 2bpp,
               everything else the ROM's depth), and this is the override for when that guess is
               wrong — an ExGFX file bound for a 2bpp slot has nothing in it that says so. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="dim" Text="depth"/>
            <ComboBox x:Name="GfxBpp" Width="88"
                      ToolTip.Tip="How to read this file: 4bpp tile data (FG/BG/sprites) or 2bpp (layer 3). Most files are STORED as three planes on an unconverted base — they still display 4bpp, with colours 8-15 out of reach"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="kind" Data="{StaticResource IconPalette}"/>
            <ComboBox x:Name="GfxPalRow" Classes="palrow"/>
            <ui:PaletteGridView x:Name="GfxColors" VerticalAlignment="Center"/>
            <TextBlock x:Name="GfxPalNote" Classes="dim" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Map16's own gutter palette, in the same place the GFX one sits: the row the selected
           tile draws with, and the sixteen colours in it. The swatches are inert on purpose — a
           Map16 tile chooses a ROW, not a colour, so a swatch that took a click would promise an
           edit this mode cannot make. -->
      <Border x:Name="M16PaletteBar" DockPanel.Dock="Bottom" Classes="panel bar" IsVisible="False"
              BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="kind" Data="{StaticResource IconPalette}"/>
          <ComboBox x:Name="M16Palette" Classes="palrow"/>
          <ui:PaletteGridView x:Name="M16Colors" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- The Animations gutter palette, the Map16 one's twin: the row the frame previews are
           coloured with and its sixteen colours. Inert swatches for the same reason — an
           ExAnimation slot moves tiles, the Map16 tile over the destination picks the row. -->
      <Border x:Name="AnimPaletteBar" DockPanel.Dock="Bottom" Classes="panel bar" IsVisible="False"
              BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="kind" Data="{StaticResource IconPalette}"/>
          <ComboBox x:Name="AnimPalRow" Classes="palrow"
                    ToolTip.Tip="The palette row the previews are coloured with — the Map16 tiles over the destination decide the real one"/>
          <ui:PaletteGridView x:Name="AnimColors" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- The Background gutter palette. Its shape is the point: layer 3 is 2bpp, so a palette
           there is FOUR colours, not sixteen, and a sixteen-wide strip would show twelve
           swatches the layer can never draw. On Layer 3 the picker is live — a tilemap word
           carries its own palette group, so choosing one here is choosing what the next stamp
           paints with. On Layer 2 it is inert for the Map16 reason: a BG tile carries its
           palette inside its own definition. -->
      <Border x:Name="BgPaletteBar" DockPanel.Dock="Bottom" Classes="panel bar" IsVisible="False"
              BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="kind" Data="{StaticResource IconPalette}"/>
          <ComboBox x:Name="BgPalRow" Classes="palrow"
                    ToolTip.Tip="The palette group the next stamp uses — bits 10-12 of the tilemap word"/>
          <ui:PaletteGridView x:Name="BgColors" VerticalAlignment="Center"/>
          <!-- Repainting 4096 cells by hand is not a way to recolour an imported tilemap, and
               changing the group is the one edit that leaves every tile where it is. -->
          <Button x:Name="BgApplyPal" Click="OnApplyBgPalette" IsVisible="False"
                  ToolTip.Tip="Write this palette group into cells that already have tiles, leaving the tiles alone"/>
          <!-- The colours themselves are edited on the Palette tab; this lands you there, on this
               group, with the tab narrowed to what layer 3 can reach. -->
          <Button x:Name="BgEditPal" Content="Edit" Click="OnEditBgPalette" IsVisible="False"
                  ToolTip.Tip="Edit this palette group's colours on the Palette tab"/>
        </StackPanel>
      </Border>

      <!-- Canvas modes share the region: exactly one is visible, and the drawer keeps
           feeding whichever it is. -->
      <Panel>
        <!-- Level mode wears the same skeleton as Map16 and GFX: a bar over the canvas, under
             the mode bar, so switching modes does not move the furniture. -->
        <DockPanel x:Name="LevelPane">
          <!-- Which LAYER the canvas edits, over the canvas that edits it. Layer 2 is the same
               object stream format, so the whole editor works on it unchanged — this only says
               which one is active. -->
          <Border x:Name="LevelEditorBar" DockPanel.Dock="Top" Classes="panel bar"
                  BorderThickness="0,0,0,1" Padding="10,6" MinHeight="40">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ToggleButton x:Name="LayerOne" Classes="mode" IsChecked="True" Click="OnEditLayer"
                            ToolTip.Tip="Edit layer 1's objects — the level itself">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconMountain}"/>
                  <TextBlock Text="Layer 1" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="LayerTwo" Classes="mode" Click="OnEditLayer"
                            ToolTip.Tip="Edit layer 2's objects. Levels whose layer 2 is a background image have none.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconMountainSnow}"/>
                  <TextBlock Text="Layer 2" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <Rectangle Classes="sep"/>
              <!-- Exits are a property of the LEVEL, so they belong to the level canvas rather
                   than the mode bar, where they sat next to two modes that cannot use them.
                   A toggle, not a button: it arms a canvas mode that takes over from the layer
                   being edited, rather than opening a table away from the level. -->
              <!-- Where the level is entered, next to where it leads: the two halves of a
                   connection, and only one of them can own the canvas at a time. -->
              <ToggleButton x:Name="EntrancesMode" Classes="mode" Click="OnEntrancesMode"
                            ToolTip.Tip="Entrances: where this level puts Mario, from the overworld and from a secondary exit.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconDoorClosed}"/>
                  <TextBlock Text="Entrances" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ExitsMode" Classes="mode" Click="OnExitsMode"
                            ToolTip.Tip="Screen exits: every screen that leads somewhere is badged with where it goes. Click a screen to set it.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconDoorOpen}"/>
                  <TextBlock Text="Exits" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <!-- Both only exist for a level whose layer 2 this project made editable, so the
                   separator goes with the button rather than hanging on an empty bar. -->
              <Rectangle Classes="sep"/>
              <!-- Icon-only overlays: the dashed square is the hitbox outline, the flower is
                   what a block releases. The tooltip carries the words. -->
              <ToggleButton x:Name="HitboxesToggle" MinWidth="34"
                            ToolTip.Tip="Hitboxes — what each tile is solid as: blocks, ledges, slopes, and what hurts">
                <Path Data="{StaticResource IconSquareDashed}"/>
              </ToggleButton>
              <ToggleButton x:Name="SpawnsToggle" MinWidth="34"
                            ToolTip.Tip="Spawns — the sprite each block releases when hit, here and in the Tiles drawer">
                <Path Data="{StaticResource IconFlower2}"/>
              </ToggleButton>
              <Rectangle Classes="sep" IsVisible="{Binding #DropLayer2.IsVisible}"/>
              <Button x:Name="DropLayer2" Content="−L2" MinWidth="52" Click="OnDropLayer2"
                      ToolTip.Tip="Drop this project's layer-2 objects and restore the base ROM's background image"/>
              <TextBlock x:Name="Layer2Note" Classes="mono" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- The desk lives on the SCROLL VIEWER, not the canvas: a centred level no longer
               covers the whole viewport, and the space it leaves is desk like any other. -->
          <ScrollViewer x:Name="CanvasScroll"
                        Background="{x:Static ui:UiColors.DeskPattern}"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ui:LevelView x:Name="Canvas"/>
          </ScrollViewer>
        </DockPanel>
        <!-- Map16 mode wears the same skeleton as GFX: a bar over the canvas and one over the
             drawer, both sitting under the mode bar, so switching between the two modes does not
             move the furniture. -->
        <DockPanel x:Name="Map16Pane" IsVisible="False">
          <!-- What the selected tile IS, over the canvas it is selected on. MinHeight so the
               strip does not collapse when an unallocated tile hides the row — the drawer's
               header takes its height from this one. -->
          <Border x:Name="Map16EditorBar" DockPanel.Dock="Top" Classes="panel bar"
                  BorderThickness="0,0,0,1" Padding="10,6" MinHeight="40">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- The grain comes first because it decides what everything after it means. -->
              <ToggleButton x:Name="Grain16" IsChecked="True" MinWidth="52" Content="16x16"
                            Click="OnGrain" ToolTip.Tip="Edit whole 16x16 tiles"/>
              <ToggleButton x:Name="Grain8" MinWidth="52" Content="8x8"
                            Click="OnGrain" ToolTip.Tip="Edit the 8x8 quadrants inside a tile"/>
              <Rectangle Classes="sep"/>
              <!-- The drawer's Pages checkbox, for the editor: a toggle button because this bar
                   keeps every other mode's height (see Priority below). -->
              <ToggleButton x:Name="M16Pages" MinWidth="34"
                            ToolTip.Tip="Pages — outline and number each Map16 page on the sheet">
                <Path Data="{StaticResource IconStickyNote}"/>
              </ToggleButton>
              <ToggleButton x:Name="M16Hitboxes" MinWidth="34"
                            ToolTip.Tip="Hitboxes — what each tile is solid as, from its Act as setting">
                <Path Data="{StaticResource IconSquareDashed}"/>
              </ToggleButton>
              <ToggleButton x:Name="M16Spawns" MinWidth="34"
                            ToolTip.Tip="Spawns — the sprite each block releases when hit, from its Act as setting">
                <Path Data="{StaticResource IconFlower2}"/>
              </ToggleButton>
              <Rectangle Classes="sep"/>
              <!-- Monospaced: proportional hex digits are different widths, so every tile the
                   cursor crosses nudged the whole row along. .mono at the readout's own 12px —
                   it is a readout like every other one, not a heading — with the full-strength
                   foreground, since this one names what the whole bar acts on. -->
              <TextBlock x:Name="M16SelLabel" Classes="mono"/>
              <!-- Either the fields or the warning, never both: an unallocated tile has nothing
                   to show them for. -->
              <StackPanel x:Name="M16Fields" Orientation="Horizontal" Spacing="6">
                <Rectangle Classes="sep"/>
                <TextBlock Classes="dim" Text="acts as"/>
                <TextBox x:Name="M16Acts" Width="64"/>
                <TextBlock x:Name="M16ActsNote" Classes="mono"/>
                <Rectangle Classes="sep"/>
                <!-- A toggle button, not a checkbox: Fluent's checkbox carries a 32px floor
                     inside its template that no MinHeight on the control can lower, and one
                     32px control makes this bar taller than every other mode's. -->
                <ToggleButton x:Name="M16Priority" Content="Priority"/>
                <Rectangle Classes="sep"/>
                <Button MinWidth="44" Click="OnFlipX" ToolTip.Tip="Flip the selected tiles horizontally">
                  <Path Data="{StaticResource IconFlipHorizontal}"/>
                </Button>
                <Button MinWidth="44" Click="OnFlipY" ToolTip.Tip="Flip the selected tiles vertically">
                  <Path Data="{StaticResource IconFlipVertical}"/>
                </Button>
              </StackPanel>
              <TextBlock x:Name="M16Unallocated" Classes="dim" IsVisible="False"
                         Text="No definition yet — paint on it to create its page."/>
            </StackPanel>
          </Border>
          <Panel x:Name="Map16Desk">
            <ScrollViewer x:Name="Map16Scroll"
                          Background="{x:Static ui:UiColors.DeskPattern}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ui:Map16CanvasView x:Name="Map16Canvas" Margin="8"/>
            </ScrollViewer>
            <!-- What the tile UNDER THE POINTER is and acts as, in a card at the corner. The
                 bar's field is the selected tile's; this one answers "and what is that?" without
                 having to select it. The name line only shows for tiles Map16Tiles.json knows. -->
            <Border x:Name="M16ActsTip" Classes="panel" CornerRadius="6" BorderThickness="1"
                    Padding="10,6" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    IsHitTestVisible="False" IsVisible="False">
              <StackPanel Spacing="2">
                <TextBlock x:Name="M16TileTipText" IsVisible="False" TextWrapping="Wrap" MaxWidth="360"/>
                <TextBlock x:Name="M16ActsTipText" Classes="dim"/>
              </StackPanel>
            </Border>
          </Panel>
        </DockPanel>
        <!-- Animations mode: ExAnimation management. Same skeleton — a bar over the work area,
             under the mode bar. ponytail: skeleton; the body is a readout of what the level
             animates until the editor proper exists. -->
        <DockPanel x:Name="AnimPane" IsVisible="False" Background="{DynamicResource VoidBrush}">
          <!-- Right drawer: the animated preview, out of the timeline's way. -->
          <Border DockPanel.Dock="Right" Classes="panel" BorderThickness="1,0,0,0" Width="260">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="panel bar" BorderThickness="0,0,0,1"
                      Padding="10,0" Height="{Binding #AnimEditorBar.Bounds.Height}">
                <TextBlock Classes="subject" Text="Preview" VerticalAlignment="Center"/>
              </Border>
              <StackPanel x:Name="AnimPreviewBody" Margin="12" Spacing="8"/>
            </DockPanel>
          </Border>
          <Border x:Name="AnimEditorBar" DockPanel.Dock="Top" Classes="panel bar"
                  BorderThickness="0,0,0,1" Padding="10,6" MinHeight="40">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Which list the timeline edits: the level's own slots or the global list that
                   runs in every level. Same toggle grammar as the Level pane's layer buttons. -->
              <ToggleButton x:Name="AnimGlobal" Classes="mode" IsChecked="True" Click="OnAnimList"
                            ToolTip.Tip="The global list — runs in every level">
                <TextBlock Text="Global" VerticalAlignment="Center"/>
              </ToggleButton>
              <ToggleButton x:Name="AnimLevel" Classes="mode" Click="OnAnimList"
                            ToolTip.Tip="This level's ExAnimation slots">
                <TextBlock Text="Level" VerticalAlignment="Center"/>
              </ToggleButton>
              <Rectangle Classes="sep"/>
              <Button Click="OnAnimAdd" ToolTip.Tip="Add a slot to this list">
                <TextBlock Text="Add slot" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="AnimDelete" Click="OnAnimDelete" IsEnabled="False" ToolTip.Tip="Delete the open slot">
                <TextBlock Text="Delete slot" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="AnimReassign" Click="OnAnimReassign" IsEnabled="False"
                      ToolTip.Tip="Move the open slot to another slot number">
                <TextBlock Text="Reassign slot" VerticalAlignment="Center"/>
              </Button>
              <TextBlock Classes="dim" Text="source file" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <ComboBox x:Name="AnimFile" Width="96" SelectedIndex="0"
                        ToolTip.Tip="Which uncompressed file (ExGFX 60-63) this list's alternate-file slots read">
                <ComboBoxItem Content="file 60"/><ComboBoxItem Content="file 61"/>
                <ComboBoxItem Content="file 62"/><ComboBoxItem Content="file 63"/>
              </ComboBox>
              <CheckBox x:Name="AnimAdvanced" Content="Advanced" Margin="8,0,0,0"
                        ToolTip.Tip="Show every slot type and trigger the engine supports"/>
              <TextBlock x:Name="AnimTitle" Classes="dim" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
          </Border>
          <!-- The timeline sits on the desk pattern (set in code: UiColors.DeskPattern). The Grid
               lets the empty-list Add Slot button sit truly centred over the desk. -->
          <Grid>
            <ScrollViewer x:Name="AnimBodyScroll">
              <StackPanel x:Name="AnimBody" Margin="16" Spacing="6"/>
            </ScrollViewer>
            <Button x:Name="AnimEmptyAdd" Classes="cta" Click="OnAnimAdd" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Content="Add Slot" ToolTip.Tip="Add a slot to this list"/>
          </Grid>
        </DockPanel>
        <!-- Background canvas mode: the level's layer-2 background as a 16x16 tile map, and
             (later) layer 3. Layer 2 here is the background IMAGE only — an object-mode layer 2
             is edited on the Level canvas, which is the same split Lunar Magic draws. -->
        <DockPanel x:Name="BgPane" IsVisible="False" Background="{DynamicResource VoidBrush}">
          <Border x:Name="BgEditorBar" DockPanel.Dock="Top" Classes="panel bar"
                  BorderThickness="0,0,0,1" Padding="10,6" MinHeight="40">
            <!-- The settings button belongs to Layer 3 alone, so it is hidden on Layer 2 rather
                 than disabled: a control that can never apply to what is on screen is noise. -->
            <DockPanel>
              <Button x:Name="BgOptions" DockPanel.Dock="Right" Content="Layer 3 Options"
                      VerticalAlignment="Center" IsVisible="False" Click="OnLayer3Options"
                      ToolTip.Tip="Which layer 3 this level gets, and whether it draws in front"/>
              <!-- Painting is saved with the project like every other level edit, so these two
                   are about FILES, and having only one of them read as "a tilemap can only come
                   from a file". -->
              <!-- The project's saved tilemaps, for whichever layer is on screen: click one to put
                   it on this level, or keep this level's as a new one. Files are the two buttons
                   beside it; this is the library. -->
              <Button x:Name="BgTilemaps" DockPanel.Dock="Right" Content="Tilemaps ▾"
                      VerticalAlignment="Center" Margin="0,0,6,0"
                      ToolTip.Tip="Saved tilemaps in this project — apply one here, or save this level's"/>
              <Button x:Name="BgExportMap" DockPanel.Dock="Right" Content="Export…"
                      VerticalAlignment="Center" IsVisible="False" Margin="0,0,6,0"
                      Click="OnExportLayer3Tilemap"
                      ToolTip.Tip="Write this level's layer-3 tilemap out as an LT3 file"/>
              <Button x:Name="BgImportMap" DockPanel.Dock="Right" Content="Import…"
                      VerticalAlignment="Center" IsVisible="False" Margin="0,0,6,0"
                      Click="OnImportLayer3Tilemap"
                      ToolTip.Tip="Import a raw layer-3 tilemap (0x800/0x1000/0x2000 bytes) for this level"/>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="BgLayer2" Classes="mode" IsChecked="True" Click="OnBgLayer"
                              ToolTip.Tip="The level's layer-2 background image">
                  <TextBlock Text="Layer 2" VerticalAlignment="Center"/>
                </ToggleButton>
                <ToggleButton x:Name="BgLayer3" Classes="mode" Click="OnBgLayer"
                              ToolTip.Tip="The level's layer-3 tile map">
                  <TextBlock Text="Layer 3" VerticalAlignment="Center"/>
                </ToggleButton>
                <Rectangle Classes="sep"/>
              </StackPanel>
              <TextBlock x:Name="BgNote" Classes="dim" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="6,0,10,0"/>
            </DockPanel>
          </Border>
          <ScrollViewer x:Name="BgScroll" HorizontalScrollBarVisibility="Auto"
                        Background="{x:Static ui:UiColors.DeskPattern}">
            <ui:TilemapView x:Name="BgView" Margin="16"/>
          </ScrollViewer>
        </DockPanel>
        <DockPanel x:Name="GfxScroll" IsVisible="False" Background="{DynamicResource VoidBrush}">
          <Border x:Name="GfxEditorBar" DockPanel.Dock="Top" Classes="panel bar"
                  BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button MinWidth="80" Click="OnBrowseGfx"
                      ToolTip.Tip="Load another graphics file into the editor">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconFolderSearch}"/>
                  <TextBlock Text="Load" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="GfxSave" MinWidth="80" Click="OnSaveGfx"
                      ToolTip.Tip="Save these pixels into the project as a custom ExGFX file">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconSave}"/>
                  <TextBlock Text="Save" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="GfxSaveAs" MinWidth="80" Click="OnSaveGfxAs"
                      ToolTip.Tip="Save a copy as a new custom ExGFX file">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconSave}"/>
                  <TextBlock Text="Save As" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Rectangle Classes="sep"/>
              <!-- The pointer leads the bar: it is the tool that touches nothing, so it is the
                   safe place to leave the mouse between edits. -->
              <ToggleButton x:Name="GfxSelect" Classes="mode" MinWidth="44" Click="OnGfxTool"
                            ToolTip.Tip="Select — drag a box, then drag it to move it. Ctrl+C/X copy or cut it, Ctrl+V pastes (into other bins too). F cycles tools">
                <Path Data="{StaticResource IconMousePointer2}"/>
              </ToggleButton>
              <ToggleButton x:Name="GfxErase" Classes="mode" MinWidth="44" Click="OnGfxTool"
                            ToolTip.Tip="Eraser — clears a pixel to transparent. F cycles tools">
                <Path Data="{StaticResource IconEraser}"/>
              </ToggleButton>
              <ToggleButton x:Name="GfxFill" Classes="mode" MinWidth="44" Click="OnGfxTool"
                            ToolTip.Tip="Fill the tile under the cursor. F cycles tools">
                <Path Data="{StaticResource IconPaintBucket}"/>
              </ToggleButton>
              <ToggleButton x:Name="GfxPencil" Classes="mode" MinWidth="44" Click="OnGfxTool"
                            ToolTip.Tip="Pencil. F cycles tools">
                <Path Data="{StaticResource IconPencil}"/>
              </ToggleButton>
              <ToggleButton x:Name="GfxDropper" Classes="mode" MinWidth="44" Click="OnGfxTool"
                            ToolTip.Tip="Eyedropper — takes the colour under the cursor. Right-click does it with any tool">
                <Path Data="{StaticResource IconPipette}"/>
              </ToggleButton>
              <!-- A combo tool: one slot on the bar, two shapes. Clicking it arms the tool AND
                   opens the variant list, so the second click of a switch is the pick rather
                   than a hunt for a caret. The icon carries the current variant. -->
              <ToggleButton x:Name="GfxRect" Classes="mode" MinWidth="44" Click="OnGfxRect"
                            ToolTip.Tip="Rectangle — drag to draw one. Click the button for outline or filled. F cycles tools">
                <Path x:Name="GfxRectIcon" Data="{StaticResource IconSquare}"/>
                <!-- A plain Flyout of the SAME toggles the bar uses, not a MenuFlyout: a
                     MenuItem reserves an icon column and a submenu chevron, so an icon-only
                     item comes out wide and left-shifted. These size to the icons and show
                     which variant is armed. -->
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="picker">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <ToggleButton x:Name="GfxRectOutlineBtn" Classes="mode" MinWidth="40"
                                    Click="OnGfxRectOutline" ToolTip.Tip="Outline">
                        <Path Data="{StaticResource IconSquare}"/>
                      </ToggleButton>
                      <ToggleButton x:Name="GfxRectFilledBtn" Classes="mode" MinWidth="40"
                                    Click="OnGfxRectFilled" ToolTip.Tip="Filled">
                        <Path Data="{StaticResource IconSquare}" Classes="filled"/>
                      </ToggleButton>
                    </StackPanel>
                  </Flyout>
                </FlyoutBase.AttachedFlyout>
              </ToggleButton>
              <!-- Same combo shape as Rect: one slot, outline or filled, icon carries which. -->
              <ToggleButton x:Name="GfxEllipse" Classes="mode" MinWidth="44" Click="OnGfxEllipse"
                            ToolTip.Tip="Ellipse — drag to draw one. Click the button for outline or filled. F cycles tools">
                <Path x:Name="GfxEllipseIcon" Data="{StaticResource IconCircle}"/>
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="picker">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <ToggleButton x:Name="GfxEllipseOutlineBtn" Classes="mode" MinWidth="40"
                                    Click="OnGfxEllipseOutline" ToolTip.Tip="Outline">
                        <Path Data="{StaticResource IconCircle}"/>
                      </ToggleButton>
                      <ToggleButton x:Name="GfxEllipseFilledBtn" Classes="mode" MinWidth="40"
                                    Click="OnGfxEllipseFilled" ToolTip.Tip="Filled">
                        <Path Data="{StaticResource IconCircle}" Classes="filled"/>
                      </ToggleButton>
                    </StackPanel>
                  </Flyout>
                </FlyoutBase.AttachedFlyout>
              </ToggleButton>
              <!-- No variants: a line is a line. Plain OnGfxTool, like the pencil. -->
              <ToggleButton x:Name="GfxLine" Classes="mode" MinWidth="44" Click="OnGfxTool"
                            ToolTip.Tip="Line — drag from one end to the other. F cycles tools">
                <Path Data="{StaticResource IconLine}"/>
              </ToggleButton>
              <Rectangle Classes="sep"/>
              <!-- Acting ON a selection rather than choosing a tool, so plain Buttons: they do
                   the thing once and grey out when there is nothing to do it to. The quarter
                   turns need a square — a w×h block turned is h×w, with nowhere to put it. -->
              <Button x:Name="GfxRotL" MinWidth="44" Click="OnGfxXform"
                      ToolTip.Tip="Rotate the selection 90° left — the marquee turns with it. Hold Ctrl while dragging to select a square">
                <Path Data="{StaticResource IconRotateCcw}"/>
              </Button>
              <Button x:Name="GfxRotR" MinWidth="44" Click="OnGfxXform"
                      ToolTip.Tip="Rotate the selection 90° right — the marquee turns with it. Hold Ctrl while dragging to select a square">
                <Path Data="{StaticResource IconRotateCw}"/>
              </Button>
              <Button x:Name="GfxFlipH" MinWidth="44" Click="OnGfxXform"
                      ToolTip.Tip="Flip the selection horizontally">
                <Path Data="{StaticResource IconFlipHorizontal}"/>
              </Button>
              <Button x:Name="GfxFlipV" MinWidth="44" Click="OnGfxXform"
                      ToolTip.Tip="Flip the selection vertically">
                <Path Data="{StaticResource IconFlipVertical}"/>
              </Button>
            </StackPanel>
          </Border>
          <!-- An empty bin has no sheet to draw, so the canvas offers the one thing that can
               change that instead of sitting blank. Same handler as the header's Load. -->
          <Panel Background="{x:Static ui:UiColors.DeskPattern}">
            <ScrollViewer x:Name="GfxSheetScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ui:GfxCanvasView x:Name="GfxCanvas" Margin="8"/>
            </ScrollViewer>
            <Button x:Name="GfxEmptyLoad" Classes="cta" IsVisible="False" Click="OnBrowseGfx"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip.Tip="This bin has no graphics — load a file into it">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource IconFolderSearch}"/>
                <TextBlock Text="Load" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Panel>
        </DockPanel>
      </Panel>
      </DockPanel>
    </Grid>

  </DockPanel>
</Window>
