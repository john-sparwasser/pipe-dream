<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PipeDream.Ui"
        x:Class="PipeDream.Ui.MainWindow"
        Title="pipe-dream" Width="1500" Height="900"
        Icon="/assets/pipe-icon-64.png"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <!-- Header mode toggle: the canvas IS the editor, so switching editors is a canvas mode
         rather than another panel competing for the drawer. -->
    <Style Selector="ToggleButton.mode">
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="MinWidth" Value="82"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ToggleButton.mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.mode:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Width" Value="4"/>
    </Style>
    <!-- Catalog rows are their own height (a 48px thumbnail), so the default item padding
         would waste half the drawer. -->
    <Style Selector="ListBox.catalog ListBoxItem">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project…" Click="OnNewProject" InputGesture="Ctrl+N"/>
        <MenuItem Header="_Open Project…" Click="OnOpenProject" InputGesture="Ctrl+O"/>
        <MenuItem x:Name="RecentMenu" Header="_Recent Projects"/>
        <MenuItem Header="Open _ROM…" Click="OnOpenRom"/>
        <Separator/>
        <MenuItem Header="_Save" Click="OnSave" InputGesture="Ctrl+S"/>
        <MenuItem Header="_Build ROM" Click="OnBuild" InputGesture="Ctrl+B"/>
        <MenuItem Header="Export _BPS patch" Click="OnExportBps"/>
        <Separator/>
        <MenuItem x:Name="UpgradePrepItem" Header="Upgrade base prep" Click="OnUpgradePrep"/>
        <MenuItem Header="Set vanilla ROM…" Click="OnSetVanilla"/>
        <MenuItem Header="ROM _info…" Click="OnRomInfo"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="OnUndo" InputGesture="Ctrl+Z"/>
        <MenuItem Header="_Redo" Click="OnRedo" InputGesture="Ctrl+Y"/>
      </MenuItem>
      <MenuItem Header="_Level">
        <MenuItem Header="_Properties…" Click="OnLevelProperties" InputGesture="Ctrl+L"/>
        <MenuItem Header="_Reload from project" Click="OnReloadLevel" InputGesture="Ctrl+R"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _palette" Click="OnTogglePalette" InputGesture="Ctrl+P"/>
        <MenuItem Header="Screen _grid" Click="OnToggleGrid" InputGesture="Ctrl+G"/>
        <Separator/>
        <MenuItem x:Name="SpriteOverlayItem" Header="_Sprite overlay" Click="OnToggleSprites"/>
        <MenuItem x:Name="AnimateItem" Header="_Animate tiles" Click="OnToggleAnimate"/>
      </MenuItem>
    </Menu>

    <!-- Header: canvas-mode toggle + per-mode controls -->
    <Border DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1" Padding="10,7">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton x:Name="ModeLevel" Classes="mode" Content="Level" IsChecked="True" Click="OnMode"/>
        <ToggleButton x:Name="ModeMap16" Classes="mode" Content="Map16" Click="OnMode"/>
        <ToggleButton x:Name="ModeGfx"   Classes="mode" Content="GFX"   Click="OnMode"/>

        <Rectangle Width="1" Margin="10,3" Fill="{DynamicResource BorderBrush}"/>

        <!-- Which LAYER the canvas edits. Layer 2 is the same object stream format, so the whole
             editor works on it unchanged — this only says which one is active. -->
        <ToggleButton x:Name="LayerOne" Classes="mode" MinWidth="40" Content="L1"
                      IsChecked="True" Click="OnEditLayer"/>
        <ToggleButton x:Name="LayerTwo" Classes="mode" MinWidth="40" Content="L2" Click="OnEditLayer"/>
        <Button x:Name="BgButton" Content="BG…" Padding="8,3" Click="OnPickBackground"
                ToolTip.Tip="Pick which background image layer 2 uses"/>
        <Button x:Name="AddLayer2" Content="+L2" Padding="8,3" Click="OnAddLayer2"
                ToolTip.Tip="Layer 2 is a background image — give it an editable object layer. Most background levels also use a level mode that never loads layer-2 objects, so change the mode in Properties as well."/>
        <Button x:Name="DropLayer2" Content="−L2" Padding="8,3" Click="OnDropLayer2"
                ToolTip.Tip="Drop this project's layer-2 objects and restore the base ROM's background image"/>
        <TextBlock x:Name="Layer2Note" Classes="mono"/>

        <Rectangle Width="1" Margin="10,3" Fill="{DynamicResource BorderBrush}"/>

        <TextBlock Classes="dim" Text="level"/>
        <ComboBox x:Name="LevelBox" Width="96"/>
        <Button Content="Reload" Padding="8,3" Click="OnReloadLevel"/>
        <Button Content="Exits" Padding="8,3" Click="OnLevelExits"/>

        <TextBlock Classes="dim" Text="zoom" Margin="10,0,0,0"/>
        <Slider x:Name="ZoomSlider" Width="140" Minimum="1" Maximum="8" Value="2"
                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        <TextBlock x:Name="ZoomLabel" Classes="mono" Width="26"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="panel" BorderThickness="0,1,0,0" Padding="12,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Status" Classes="dim" Text="no ROM loaded — File ▸ Open ROM"/>
        <TextBlock x:Name="Hover" Grid.Column="1" Classes="mono"/>
      </Grid>
    </Border>

    <!-- Drawer | splitter | canvas. A Grid rather than a docked panel so the drawer can be
         dragged to whatever width the work needs. -->
    <Grid x:Name="Split" ColumnDefinitions="420,Auto,*">

      <Border x:Name="Drawer" Classes="panel" BorderThickness="0,0,1,0">
        <DockPanel>
          <TabStrip x:Name="PaletteTabs" DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}">
            <TabStripItem Content="Map16" IsSelected="True"/>
            <TabStripItem Content="Sprites"/>
            <TabStripItem Content="Objects"/>
            <TabStripItem Content="Palette"/>
            <TabStripItem Content="GFX"/>
          </TabStrip>

          <Border x:Name="PaletteBar" DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="dim" Text="bank"/>
              <ComboBox x:Name="BankBox" Width="74" SelectedIndex="0">
                <ComboBoxItem Content="0 FG"/>
                <ComboBoxItem Content="1 FG"/>
                <ComboBoxItem Content="2 BG"/>
              </ComboBox>
              <TextBlock Classes="dim" Text="size" Margin="8,0,0,0"/>
              <Slider x:Name="TileZoom" Width="90" Minimum="1" Maximum="4" Value="2"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
              <TextBlock x:Name="SelLabel" Classes="mono" Margin="6,0,0,0"/>
            </StackPanel>
          </Border>

          <!-- The drawer follows the canvas mode: Map16 tiles for the level, 8x8 GFX for
               the Map16 editor. Pick here, stamp there — one grammar at both levels. -->
          <Panel>
            <ScrollViewer x:Name="PaletteScroll" HorizontalScrollBarVisibility="Auto">
              <ui:Map16PaletteView x:Name="Palette" Margin="8"/>
            </ScrollViewer>
            <DockPanel x:Name="ChrPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="dim" Text="palette"/>
                  <ComboBox x:Name="PalRowBox" Width="66" SelectedIndex="2"/>
                  <CheckBox x:Name="ChrFlipX" Content="X"/>
                  <CheckBox x:Name="ChrFlipY" Content="Y"/>
                  <CheckBox x:Name="ChrPrio" Content="Pri"/>
                </StackPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <ui:ChrPaletteView x:Name="Chr" Margin="8"/>
              </ScrollViewer>
            </DockPanel>

            <!-- Sprite catalog: pick here, RIGHT-click the level to place. Sprites whose GFX
                 this level does not load are shown greyed rather than hidden — they still
                 place, they just draw as garbage until the GFX slots are changed. -->
            <DockPanel x:Name="SpritePanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox x:Name="LoadedOnly" Content="Loaded only" IsChecked="True"/>
                  <TextBlock x:Name="SpFiles" Classes="mono"/>
                </StackPanel>
              </Border>
              <ListBox x:Name="SpriteList" Classes="catalog" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="{Binding Thumb}" Width="32" Height="32" Stretch="None"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"/>
                        <TextBlock Text="GFX not loaded" FontSize="10" IsVisible="{Binding !Loaded}"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Object catalog: thumbnails are composed from the cells each object really
                 writes in THIS tileset, so an irregular object looks like itself. -->
            <DockPanel x:Name="ObjectPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <TextBlock x:Name="ObjectHint" Classes="dim" TextWrapping="Wrap"/>
              </Border>
              <ListBox x:Name="ObjectList" Classes="catalog" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="{Binding Thumb}" Width="48" Height="48" Stretch="None"/>
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Palette: the level's CGRAM, edited in the SNES's own colour space. Five bits per
                 channel is what the hardware stores, so sliders of 0-31 are exact where a
                 24-bit picker would quantise behind your back. -->
            <DockPanel x:Name="PalettePanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="PaletteNote" Classes="dim" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PaletteIndex" Classes="mono" Width="96"/>
                    <Button x:Name="PaletteReset" Content="Reset" Padding="10,2" Click="OnResetPalette"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="14,*,32" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                    <TextBlock Classes="dim" Text="R"/>
                    <Slider x:Name="PalR" Grid.Column="1" Minimum="0" Maximum="31"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="PalRv" Grid.Column="2" Classes="mono"/>
                    <TextBlock Grid.Row="1" Classes="dim" Text="G"/>
                    <Slider x:Name="PalG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="31"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="PalGv" Grid.Row="1" Grid.Column="2" Classes="mono"/>
                    <TextBlock Grid.Row="2" Classes="dim" Text="B"/>
                    <Slider x:Name="PalB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="31"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="PalBv" Grid.Row="2" Grid.Column="2" Classes="mono"/>
                  </Grid>
                </StackPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <ui:PaletteGridView x:Name="PaletteGrid" Margin="8"/>
              </ScrollViewer>
            </DockPanel>

            <!-- GFX tab: the level's ten VRAM bins. Each one shows what it currently holds and
                 can be repointed by id, by picking a file, or by importing a raw .bin. -->
            <ScrollViewer x:Name="GfxBinPanel" IsVisible="False">
              <StackPanel x:Name="GfxBins" Margin="8" Spacing="8"/>
            </ScrollViewer>

            <!-- GFX canvas mode's drawer: the paint colours and a jump list of the level's
                 bins, so the file you want is one click away rather than a hex id to recall. -->
            <DockPanel x:Name="GfxToolPanel" IsVisible="False">
              <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource SurfaceBrush}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="dim" Text="palette"/>
                    <ComboBox x:Name="GfxPalRow" Width="66"/>
                    <TextBlock x:Name="GfxColorNote" Classes="mono"/>
                  </StackPanel>
                  <ui:PaletteGridView x:Name="GfxColors" HorizontalAlignment="Left"/>
                  <TextBlock Classes="dim" Text="level bins"/>
                </StackPanel>
              </Border>
              <ScrollViewer>
                <StackPanel x:Name="GfxJumps" Margin="10,4" Spacing="3"/>
              </ScrollViewer>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

      <DockPanel Grid.Column="2">

      <!-- Map16 mode gets a right-hand inspector for the selected tile(s): what it acts as, its
           palette row, priority and flips. Mode-specific, so it appears with the mode. -->
      <Border x:Name="Map16Props" DockPanel.Dock="Right" Classes="panel" IsVisible="False"
              BorderThickness="1,0,0,0" Padding="12,10" Width="220">
        <StackPanel Spacing="10">
          <TextBlock x:Name="M16SelLabel" Classes="dim" TextWrapping="Wrap"/>
          <Rectangle Height="1" Fill="{DynamicResource BorderBrush}"/>
          <StackPanel x:Name="M16Fields" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="dim" Text="Acts as" VerticalAlignment="Center"/>
              <TextBox x:Name="M16Acts" Width="64"/>
            </StackPanel>
            <TextBlock x:Name="M16ActsNote" Classes="mono" TextWrapping="Wrap"/>
            <CheckBox x:Name="M16Priority" Content="Priority"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="dim" Text="Palette" VerticalAlignment="Center"/>
              <ComboBox x:Name="M16Palette" Width="66"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Flip X" Click="OnFlipX"/>
              <Button Content="Flip Y" Click="OnFlipY"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="M16Unallocated" Classes="dim" IsVisible="False" TextWrapping="Wrap"
                     Text="This tile has no definition yet — paint on it to create its page."/>
        </StackPanel>
      </Border>

      <!-- Canvas modes share the region: exactly one is visible, and the drawer keeps
           feeding whichever it is. -->
      <Panel>
        <ScrollViewer x:Name="CanvasScroll"
                      Background="{DynamicResource VoidBrush}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ui:LevelView x:Name="Canvas"/>
        </ScrollViewer>
        <ScrollViewer x:Name="Map16Scroll" IsVisible="False"
                      Background="{DynamicResource VoidBrush}"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ui:Map16CanvasView x:Name="Map16Canvas" Margin="8"/>
        </ScrollViewer>
        <DockPanel x:Name="GfxScroll" IsVisible="False" Background="{DynamicResource VoidBrush}">
          <Border DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="dim" Text="GFX"/>
              <TextBox x:Name="GfxFileBox" Width="60" Text="014"/>
              <TextBlock x:Name="GfxFileNote" Classes="mono"/>
              <Button Content="Browse…" Padding="8,2" Click="OnBrowseGfx"/>
              <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource BorderBrush}"/>
              <Button Content="−" Width="26" Padding="0,2" Click="OnGfxZoomOut"/>
              <Button Content="+" Width="26" Padding="0,2" Click="OnGfxZoomIn"/>
              <ToggleButton x:Name="GfxPencil" Classes="mode" MinWidth="60" Content="Pencil" Click="OnGfxTool"/>
              <ToggleButton x:Name="GfxFill" Classes="mode" MinWidth="60" Content="Fill" Click="OnGfxTool"/>
              <TextBlock Classes="dim" Text="left: paint   right: pick colour   F: tool   [ ]: zoom"/>
            </StackPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ui:GfxCanvasView x:Name="GfxCanvas" Margin="8"/>
          </ScrollViewer>
        </DockPanel>
      </Panel>
      </DockPanel>
    </Grid>

  </DockPanel>
</Window>
