<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.GfxBrowserWindow"
        Title="Select GFX" Width="640" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock x:Name="Purpose" Classes="dim" TextWrapping="Wrap"/>
      <TextBlock Classes="dim" TextWrapping="Wrap"
                 Text="Base is the ROM's own graphics; custom is what this project imported or saved. Imported files keep the name of the .bin they came from, and the filter matches names anywhere and hex ids by prefix."/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="Filter" Width="220" Watermark="filter by name or id"/>
        <RadioButton x:Name="ShowBase" GroupName="Source" Content="base" IsChecked="True"
                     VerticalAlignment="Center"/>
        <RadioButton x:Name="ShowCustom" GroupName="Source" Content="custom"
                     VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="RenameHint" Classes="dim"/>
      <Button Content="Import .bin…" Click="OnImport"/>
      <Button Content="Rename…" Click="OnRename"/>
      <Button Content="Cancel" Click="OnCancel"/>
      <Button Content="Select" Click="OnSelect" IsDefault="True"/>
    </StackPanel>

    <ListBox x:Name="Files" Margin="0,10" Background="Transparent" BorderThickness="0"
             DoubleTapped="OnSelect">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="{Binding Thumb}" Width="{Binding ThumbW}" Height="{Binding ThumbH}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Label}"/>
              <TextBlock Text="{Binding Name}" Classes="mono" IsVisible="{Binding HasName}"/>
              <TextBlock Text="{Binding Description}" Classes="mono"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
