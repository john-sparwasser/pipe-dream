<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.NewBlockWindow"
        Title="New block" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Name" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
    <TextBox x:Name="BlockName" Watermark="letters, digits, _ and -"/>
    <TextBlock Text="Icon" Foreground="{DynamicResource TextDimBrush}" FontSize="12"/>
    <ListBox x:Name="Icons" Background="Transparent">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Image Source="{Binding Image}" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None"
                 ToolTip.Tip="{Binding Tip}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="Hint" Foreground="{DynamicResource TextDimBrush}" FontSize="12" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
      <Button x:Name="Okay" Content="Okay" Click="OnOkay" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
