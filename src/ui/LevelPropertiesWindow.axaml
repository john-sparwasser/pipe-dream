<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.LevelPropertiesWindow"
        Title="Level Properties" Width="500" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <!-- Header only: entry settings write into the ROM in place, so undo is what takes
             those back. Enabled only once this level actually carries a header edit. -->
        <Button x:Name="RevertBtn" Content="Revert header" Click="OnRevert"/>
        <Button Content="Cancel" Click="OnCancel"/>
        <Button x:Name="ApplyBtn" Content="Apply" Click="OnApply"/>
      </StackPanel>
    </Border>

    <!-- The two records these fields pack into, at the foot rather than beside their own
         sections: the sections are grouped by what a setting DOES, so a field's record is no
         longer something the reader can see from where it sits. -->
    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
      <StackPanel Spacing="2">
        <TextBlock x:Name="HeaderBytes" Classes="mono"/>
        <TextBlock x:Name="EntryBytes" Classes="mono"/>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel x:Name="Fields" Spacing="2"/>
    </ScrollViewer>
  </DockPanel>
</Window>
