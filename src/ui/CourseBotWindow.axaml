<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.CourseBotWindow"
        Title="Course Bot" Width="520" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Classes="dim" TextWrapping="Wrap"
                 Text="Courses are named entry levels. Creating one copies a base level — header, entrances, objects, sprites, palette and GFX bins — into a free enterable slot, so the level number stops mattering."/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="NewName" Width="190" Watermark="new course name"/>
        <TextBlock Classes="dim" Text="from"/>
        <ComboBox x:Name="BaseLevel" Width="160"/>
        <Button Content="Create" Click="OnCreate"/>
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="Hint" Classes="dim"/>
      <Button x:Name="DeleteButton" Content="Delete" Click="OnDelete"/>
      <Button Content="Close" Click="OnClose" IsCancel="True"/>
      <Button Content="Open" Click="OnOpen" IsDefault="True"/>
    </StackPanel>

    <ListBox x:Name="Courses" Margin="0,10" Background="Transparent" BorderThickness="0"
             DoubleTapped="OnOpen">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Name}"/>
            <TextBlock Text="{Binding Slot}" Classes="mono" VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
