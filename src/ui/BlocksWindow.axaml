<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.BlocksWindow"
        Title="Custom blocks" Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <!-- Header bar: New and Import always; Remove, Edit and Open act on the selected block.
         Import GPS folder brings a whole GPS folder in: its driver, routines, blocks and list. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
      <Button x:Name="NewButton" Content="New…" Click="OnNew" ToolTip.Tip="Adds a block from the template, with a name and an icon"/>
      <Button x:Name="ImportButton" Content="Import…" Click="OnImport" ToolTip.Tip="Adds .asm files from disk to the library"/>
      <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" IsEnabled="False"/>
      <Button x:Name="EditButton" Content="Edit" Click="OnEdit" IsEnabled="False"/>
      <Button x:Name="OpenButton" Click="OnOpen" IsEnabled="False"
              ToolTip.Tip="Open the block in your text editor (File ▸ Preferences); saving there updates the project"/>
      <Button Content="Import GPS folder…" Click="OnImportGps"
              ToolTip.Tip="Bring in a GPS folder: its blocks, its list of which tile runs which, and the routines they call"/>
    </StackPanel>

    <!-- A base GPS already put blocks on: nothing here may change until their folder is imported
         (EditorSession.BlocksLockedReason). -->
    <Border x:Name="LockNotice" DockPanel.Dock="Top" IsVisible="False" Margin="0,10,0,0" Padding="10,8"
            CornerRadius="4" Background="#3A2E12" BorderBrush="#8A6D1F" BorderThickness="1">
      <TextBlock x:Name="LockText" TextWrapping="Wrap" Foreground="#F2D58A" FontSize="12"/>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="Hint" Classes="dim" TextWrapping="Wrap" MaxWidth="440"/>
      <Button Content="Close" Click="OnClose" IsCancel="True"/>
    </StackPanel>

    <ListBox x:Name="Library" Margin="0,10,0,0" SelectionChanged="OnSelect" DoubleTapped="OnEdit">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Panel Width="16" Height="16">
              <Image Source="{Binding Icon}" RenderOptions.BitmapInterpolationMode="None"/>
            </Panel>
            <TextBlock Text="{Binding Name}" Classes="mono"/>
            <TextBlock Text="{Binding Note}" Classes="note"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
