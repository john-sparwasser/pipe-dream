<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PipeDream.Ui.SlotNumberWindow"
        Width="320" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" RequestedThemeVariant="Dark">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="Prompt" TextWrapping="Wrap"
               Foreground="{DynamicResource TextBrush}"/>
    <ComboBox x:Name="Numbers" HorizontalAlignment="Stretch"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
      <Button Content="OK" Click="OnOk" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
