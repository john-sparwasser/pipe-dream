diff --git a/src/tests/LoaderCostTests.cs b/src/tests/LoaderCostTests.cs
new file mode 100644
index 0000000..c16e723
--- /dev/null
+++ b/src/tests/LoaderCostTests.cs
@@ -0,0 +1,108 @@
+using Xunit;
+using Xunit.Abstractions;
+
+namespace PipeDream.Tests;
+
+/// <summary>
+/// What one run of the level sprite loader ($02A7FC) costs in a level of 255 sprites, in
+/// instructions the CPU interpreter ran, with the camera half way along.
+/// </summary>
+public class LoaderCostTests(ITestOutputHelper log)
+{
+    private static string DevRom()
+    {
+        for (var d = new DirectoryInfo(AppContext.BaseDirectory); d is not null; d = d.Parent)
+        {
+            var p = Path.Combine(d.FullName, "dev", "base.smc");
+            if (File.Exists(p)) return p;
+        }
+        throw new FileNotFoundException("dev/base.smc");
+    }
+
+    /// <summary>255 records in sorted screen order, 0..31, never on column 2, then the terminator.</summary>
+    internal static byte[] List(int count = 255)
+    {
+        var l = new List<byte> { 0 };                                // the header byte
+        for (int i = 0; i < count; i++)
+        {
+            int screen = i * 32 / count, x = 5 + i % 10;
+            l.Add((byte)(((screen >> 4) & 1) << 1));
+            l.Add((byte)((x << 4) | (screen & 0xF)));
+            l.Add(0x10);
+        }
+        l.Add(0xFF);
+        return [.. l];
+    }
+
+    /// <summary>Lunar Magic starts the walk at a per-screen section of the list, not at its head:
+    /// $0CF6,x is the section's pointer (less its header byte) and $0D36,x its first record's index.
+    /// Section s starts at the first record on screen s or later.</summary>
+    internal static long Cost(Rom rom, int cameraX, bool right, byte[] list, bool sections = true) => Run(rom, cameraX, right, list, sections).Instructions;
+
+    internal static Cpu65816 Run(Rom rom, int cameraX, bool right, byte[] list, bool sections = true)
+    {
+        var cpu = new Cpu65816(rom);
+        list.CopyTo(cpu.Ram7F, 0x8000);
+        cpu.Ram7E[0xCE] = 0x00; cpu.Ram7E[0xCF] = 0x80; cpu.Ram7E[0xD0] = 0x7F;
+        int records = (list.Length - 2) / 3;
+        for (int s = 0; s < 32; s++)
+        {
+            int first = 0;
+            while (first < records && (((list[1 + first * 3] >> 1) & 1) << 4 | (list[2 + first * 3] & 0xF)) < s) first++;
+            int ptr = sections ? 0x8000 + first * 3 : 0x8000, idx = sections ? first : 0;
+            cpu.Ram7E[0x0CF6 + s * 2] = (byte)ptr; cpu.Ram7E[0x0CF7 + s * 2] = (byte)(ptr >> 8);
+            cpu.Ram7E[0x0D36 + s * 2] = 0; cpu.Ram7E[0x0D37 + s * 2] = (byte)idx;
+        }
+        cpu.Ram7E[0x1A] = (byte)cameraX; cpu.Ram7E[0x1B] = (byte)(cameraX >> 8);
+        cpu.Ram7E[0x55] = (byte)(right ? 2 : 0);
+        cpu.PresetP(0x30);
+        cpu.PresetDbr(0x02);
+        cpu.CallNear(0x02A7FC, 5_000_000);
+        return cpu;
+    }
+
+    /// <summary>The loader steps over records of 3 and of 5 bytes (a custom sprite with two extra bytes) alike:
+    /// it reaches the list's end, every record counted.</summary>
+    [AsarRomFact]
+    public void the_loader_walks_a_list_of_mixed_record_lengths_to_its_end()
+    {
+        var dir = Directory.CreateTempSubdirectory("pdwalk-").FullName;
+        try
+        {
+            var l = new List<byte> { 0 };
+            const int count = 200;
+            for (int i = 0; i < count; i++)
+            {
+                bool custom = i % 3 == 0;
+                l.Add((byte)(custom ? 0x08 : 0)); l.Add((byte)(0x50 | (i * 16 / count))); l.Add(custom ? (byte)0x1A : (byte)0x10);
+                if (custom) { l.Add(0xAB); l.Add(0xCD); }
+            }
+            l.Add(0xFF);
+            var (status, built) = SpriteInsertTests.Build(Path.Combine(dir, "a"));
+            Assert.True(built is not null, status);
+            // The camera is past every record, so the loader only walks them (a record in its window would spawn).
+            var cpu = Run(built!, 0x2000, true, [.. l], sections: false);
+            Assert.Equal(count & 0xFF, cpu.Registers.X);
+        }
+        finally { try { Directory.Delete(dir, true); } catch { } }
+    }
+
+    [AsarRomFact]
+    public void the_drivers_step_hook_cost_is_gone_without_extra_bytes()
+    {
+        var dir = Directory.CreateTempSubdirectory("pdcost-").FullName;
+        try
+        {
+            var list = List();
+            long plain = Cost(Rom.Load(DevRom()), 0x1000, true, list);
+            var (s0, without) = SpriteInsertTests.Build(Path.Combine(dir, "a"), extraBytes: 0);
+            var (s2, with) = SpriteInsertTests.Build(Path.Combine(dir, "b"), extraBytes: 2);
+            Assert.True(without is not null && with is not null, s0 + s2);
+            long cheap = Cost(without!, 0x1000, true, list), hooked = Cost(with!, 0x1000, true, list);
+            log.WriteLine($"255 sprites, camera $1000: dev base {plain}, driver without extra bytes {cheap}, with {hooked} instructions");
+            Assert.True(cheap <= plain + 5, "the driver costs the loader nothing when no sprite takes extra bytes");
+            Assert.True(hooked > cheap);
+        }
+        finally { try { Directory.Delete(dir, true); } catch { } }
+    }
+}
