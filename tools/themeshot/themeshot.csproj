<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless screenshot harness: renders every dialog, the menu dropdowns and each main-window
       mode of the real app to PNG. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.11" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.11" />
    <ProjectReference Include="../../src/PipeDream.csproj" />
  </ItemGroup>

</Project>
