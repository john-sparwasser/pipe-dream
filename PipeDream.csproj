<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PipeDream</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\pipe-dream.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The app globs **/*.cs from the repo root; keep the sibling test project out. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FosterFramework" Version="0.3.0" />
    <PackageReference Include="ImGui.NET" Version="1.90.5.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\Data\SpriteDisplay.json" LogicalName="SpriteDisplay.json"
                      Condition="Exists('src\Data\SpriteDisplay.json')" />
    <EmbeddedResource Include="assets\pipe-icon-64.png" LogicalName="pipe-icon.png" />
  </ItemGroup>

</Project>
