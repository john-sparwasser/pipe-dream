<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PipeDream</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The app globs **/*.cs from the repo root; keep the sibling projects out. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="ui\**\*.cs" />
    <Compile Remove="services\**\*.cs" />
  </ItemGroup>

  <!--
    This is the STORAGE layer: ROM bytes, .pdp files, the patch builder. The services layer
    (services/PipeDream.Services) is the only thing above it that gets at its internals — the
    Avalonia UI deliberately does NOT, so it cannot reach past the services and touch the
    project file or the config directly.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="PipeDream.Tests" />
    <InternalsVisibleTo Include="PipeDream.Services" />
    <InternalsVisibleTo Include="PipeDream.Ui.Tests" />
  </ItemGroup>

  <!-- No UI packages. The editor is ui/PipeDream.Ui; this is the storage layer plus the
       command-line ROM tools, and it stays runnable headlessly for CI and scripting. -->
  <ItemGroup>
    <EmbeddedResource Include="src\Data\SpriteDisplay.json" LogicalName="SpriteDisplay.json"
                      Condition="Exists('src\Data\SpriteDisplay.json')" />
  </ItemGroup>

</Project>
